@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Finalizare Înregistrare";
}

<div class="container-fluid d-flex justify-content-center align-items-center py-5" style="min-height: 85vh; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
    <div class="col-md-7 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
            
            <div class="text-center mb-4 pt-2">
                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                </div>
                <h3 class="fw-bold text-navy mb-2" style="font-size: 1.75rem;">Aproape gata!</h3>
                <p class="text-muted" style="font-size: 0.95rem;">
                    Te-ai autentificat cu succes folosind <strong>@Model.ProviderDisplayName</strong>.
                </p>
            </div>

            <div class="alert alert-info border-info border-opacity-50 text-center shadow-sm small fw-semibold mb-4">
                <i class="bi bi-info-circle me-1"></i> Te rugăm să confirmi adresa de email pentru a finaliza crearea contului tău.
            </div>

            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center" role="alert"></div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Email" class="form-control rounded-3 border-light bg-light shadow-none" autocomplete="email" placeholder="nume@exemplu.com" style="height: 56px;" />
                    <label asp-for="Input.Email" class="text-muted">Adresă Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="w-100 btn py-3 fw-bold rounded-3 shadow-sm text-white" style="background-color: #ff6b35; border: none; font-size: 1rem;">
                    Confirmă și Autentifică-te
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}