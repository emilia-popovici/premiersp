@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmare înregistrare";
}

<div class="container-fluid d-flex justify-content-center align-items-center py-5" style="min-height: 85vh; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
    <div class="col-md-7 col-lg-5 col-xl-4">
        
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            
            <div class="mb-4 pt-2">
                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex p-3 text-primary mb-3">
                    <i class="bi bi-envelope-check fs-1"></i>
                </div>
                <h3 class="fw-bold text-navy mb-2" style="font-size: 1.75rem;">Verifică-ți emailul</h3>
                <p class="text-muted small">Îți mulțumim pentru înregistrare!</p>
            </div>

            @if (@Model.DisplayConfirmAccountLink)
            {
                <div class="alert alert-light border rounded-3 p-3 small text-muted mb-4">
                    Această aplicație folosește momentan un sistem de test. Poți confirma contul direct apăsând butonul de mai jos:
                </div>

                <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="w-100 btn py-3 fw-bold rounded-3 shadow-sm mb-3 text-white" style="background-color: #ff6b35; border: none; font-size: 1rem;">
                    Confirmă contul acum
                </a>
            }
            else
            {
                <div class="p-3 bg-light rounded-3 text-muted small mb-4">
                    Te rugăm să verifici căsuța de email (inclusiv folderul Spam) pentru a accesa linkul de confirmare a contului.
                </div>
            }

            <div class="text-center pt-2">
                <a asp-page="./Login" class="text-decoration-none fw-semibold text-primary small">
                    <i class="bi bi-arrow-left me-1"></i> Înapoi la autentificare
                </a>
            </div>

        </div>
    </div>
</div>