@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Setează o parolă";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5 bg-light">
                    <h3 class="text-navy fw-bold text-center mb-3">@ViewData["Title"]</h3>
                    <p class="text-center text-muted mb-4 small">
                        Nu ai o parolă locală setată pentru acest cont. Adaugă una acum pentru a te putea autentifica și fără contul extern (ex: Google).
                    </p>

                    <form id="set-password-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword" class="form-label fw-bold text-navy">Parolă nouă</label>
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Introdu o parolă sigură" />
                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-navy">Confirmă parola nouă</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmă parola" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary-cta w-100 fw-bold btn-lg">Setează parola</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}