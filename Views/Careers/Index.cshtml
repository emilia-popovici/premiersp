@model IEnumerable<PremierAuto.Models.JobPosition>
@{
    ViewData["Title"] = "Cariere";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-navy">Alătură-te Echipei Premier Auto</h1>
        <p class="text-muted">Căutăm pasionați de auto care vor să facă performanță într-un mediu profesionist.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fw-bold text-center shadow-sm">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        @foreach (var job in Model)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 @(job.IsHiring ? "border-start border-4 border-primary" : "")">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="fw-bold text-navy mb-0">@job.Title</h4>
                            @if (job.IsHiring)
                            {
                                <span class="badge bg-success px-3 py-2 rounded-pill">Angajăm</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2 rounded-pill">Poziție Închisă</span>
                            }
                        </div>
                        <p class="text-muted mb-4">@job.Description</p>
                        
                        @if (job.IsHiring)
                        {
                            <a asp-action="Apply" asp-route-id="@job.Id" class="btn btn-primary-cta fw-bold w-100">Aplică Acum <i class="bi bi-arrow-right ms-2"></i></a>
                        }
                        else
                        {
                            <button class="btn btn-light w-100 fw-bold" disabled>Momentan nu primim CV-uri</button>
                        }
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted">
                <p>Momentan nu avem poziții deschise. Revino curând!</p>
            </div>
        }
    </div>
</div>