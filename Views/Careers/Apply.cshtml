@model PremierAuto.Models.JobApplication
@{
    ViewData["Title"] = "Aplică pentru " + ViewBag.JobTitle;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-navy text-white p-4 text-center">
                    <h3 class="fw-bold mb-0">Aplică: @ViewBag.JobTitle</h3>
                </div>
                <div class="card-body p-4 p-md-5 bg-light">
                    
                    <form asp-action="Apply" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="JobPositionId" />

                        <h5 class="fw-bold text-navy mb-3">Date Personale</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Prenume</label>
                                <input asp-for="FirstName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Nume de familie</label>
                                <input asp-for="LastName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Email</label>
                                <input asp-for="Email" type="email" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Telefon</label>
                                <input asp-for="Phone" class="form-control" required />
                            </div>
                        </div>

                        <hr class="text-muted mb-4" />

                        <h5 class="fw-bold text-navy mb-3">Experiență & CV</h5>
                        <div class="alert alert-info border-0 shadow-sm small mb-4">
                            <i class="bi bi-info-circle me-2"></i> Poți încărca un CV direct <strong>SAU</strong> poți completa manual câmpurile de mai jos.
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Încarcă CV (PDF/Docx)</label>
                            <input type="file" name="cvFile" class="form-control" accept=".pdf,.doc,.docx" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Educație & Studii (Opțional dacă ai pus CV)</label>
                            <textarea asp-for="Education" class="form-control" rows="3" placeholder="Unde ai studiat..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Experiență Profesională (Opțional dacă ai pus CV)</label>
                            <textarea asp-for="Experience" class="form-control" rows="4" placeholder="Locuri de muncă anterioare, responsabilități..."></textarea>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary-cta btn-lg fw-bold">Trimite Aplicația <i class="bi bi-send ms-2"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>