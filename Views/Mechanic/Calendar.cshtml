@model IEnumerable<PremierAuto.Models.Appointment>

@{
    ViewData["Title"] = "Agenda de Lucru";
    
    var today = DateTime.Today;
    var finishedStatuses = new[] { "Done", "Canceled", "Rejected" };
    var upcomingAppointments = Model?
        .Where(a => a.AppointmentDate.Date >= today && !finishedStatuses.Contains(a.Status.ToString()))
        .GroupBy(a => a.AppointmentDate.Date)
        .OrderBy(g => g.Key)
        .ToList();

    var pastAppointments = Model?
        .Where(a => a.AppointmentDate.Date < today || finishedStatuses.Contains(a.Status.ToString()))
        .GroupBy(a => a.AppointmentDate.Date)
        .OrderByDescending(g => g.Key)
        .ToList();
}

<div class="container py-5">
    
    <div class="mb-4">
        <h2 class="fw-bold text-navy mb-2"><i class="bi bi-calendar-range me-2 text-accent"></i> Agenda Curentă</h2>
        <p class="text-muted">Programările tale active de astăzi și din zilele următoare.</p>
    </div>

    @if (upcomingAppointments == null || !upcomingAppointments.Any())
    {
        <div class="text-center py-5 bg-white rounded shadow-sm border-0 mb-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-cup-hot fs-1 text-secondary"></i>
            </div>
            <h4 class="text-navy fw-bold">Nicio programare activă</h4>
            <p class="text-muted">Timpul tău este liber! Nu ai lucrări alocate sau în așteptare pentru perioada următoare.</p>
        </div>
    }
    else
    {
        <div class="row g-5 mb-5">
            @foreach (var group in upcomingAppointments)
            {
                <div class="col-12">
                    <div class="d-flex align-items-center mb-4">
                        <h4 class="fw-bold text-navy mb-0 me-3">
                            @if (group.Key == DateTime.Today)
                            {
                                <span class="text-accent">Astăzi</span>
                            }
                            else if (group.Key == DateTime.Today.AddDays(1))
                            {
                                <span>Mâine</span>
                            }
                            else
                            {
                                @group.Key.ToString("dd MMMM yyyy")
                            }
                        </h4>
                        <span class="badge bg-light text-navy border">@group.Count() programări</span>
                        <hr class="flex-grow-1 ms-3 text-muted" style="opacity: 0.2;">
                    </div>

                    <div class="row g-4">
                        @foreach (var item in group.OrderBy(a => a.AppointmentDate))
                        {
                            var badgeColor = GetBadgeColor(item.Status.ToString());
                            var statusTranslate = TranslateStatus(item.Status.ToString());

                            <div class="col-md-6 col-lg-4">
                                <div class="card border-0 shadow-sm h-100 hover-shadow transition-all" style="border-left: 4px solid var(--accent-color) !important;">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div class="d-flex align-items-center text-navy fw-bold">
                                                <i class="bi bi-clock-history fs-5 me-2 text-accent"></i>
                                                <span class="fs-3">@item.AppointmentDate.ToString("HH:mm")</span>
                                            </div>
                                            <span class="badge @badgeColor rounded-pill px-3 py-2">@statusTranslate</span>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1"><i class="bi bi-car-front me-2 text-muted"></i>@item.CarMake @item.CarModel</h5>
                                        <div class="d-flex align-items-center text-muted mb-4 small">
                                            <i class="bi bi-person me-2 fs-6"></i>
                                            @(item.Client != null ? $"{item.Client.FirstName} {item.Client.LastName}" : "Client necunoscut")
                                        </div>
                                        <div class="bg-light p-3 rounded text-dark d-flex align-items-center border">
                                            <i class="bi bi-wrench-adjustable me-3 text-secondary fs-5"></i>
                                            <span class="fw-semibold">@(item.Service?.Name ?? "Nespecificat")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (pastAppointments != null && pastAppointments.Any())
    {
        <hr class="my-5 border-2 text-muted" style="opacity: 0.1;">
        
        <div class="mb-4 d-flex justify-content-between align-items-center p-3 bg-light rounded shadow-sm" 
             data-bs-toggle="collapse" 
             data-bs-target="#historyCollapse" 
             aria-expanded="false" 
             aria-controls="historyCollapse" 
             style="cursor: pointer;">
            <div>
                <h3 class="fw-bold text-secondary mb-1"><i class="bi bi-archive me-2"></i> Istoric Programări</h3>
                <p class="text-muted mb-0">Apasă aici pentru a vizualiza lucrările din trecut sau finalizate/anulate.</p>
            </div>
            <i class="bi bi-chevron-down fs-3 text-secondary transition-icon"></i>
        </div>
        <div class="collapse" id="historyCollapse">
            <div class="row g-5 opacity-75 mt-2"> 
                @foreach (var group in pastAppointments)
                {
                    <div class="col-12">
                        <div class="d-flex align-items-center mb-3">
                            <h5 class="fw-bold text-secondary mb-0 me-3">
                                @if (group.Key == DateTime.Today)
                                {
                                    <span>Astăzi</span>
                                }
                                else if (group.Key == DateTime.Today.AddDays(1))
                                {
                                    <span>Mâine</span>
                                }
                                else
                                {
                                    @group.Key.ToString("dd MMMM yyyy")
                                }
                            </h5>
                            <hr class="flex-grow-1 ms-3 text-muted" style="opacity: 0.1;">
                        </div>

                        <div class="row g-4">
                            @foreach (var item in group.OrderByDescending(a => a.AppointmentDate))
                            {
                                var badgeColor = GetBadgeColor(item.Status.ToString());
                                var statusTranslate = TranslateStatus(item.Status.ToString());

                                <div class="col-md-6 col-lg-4">
                                    <div class="card border-0 shadow-sm h-100 bg-light" style="border-left: 4px solid #adb5bd !important;">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="d-flex align-items-center text-secondary fw-bold">
                                                    <i class="bi bi-clock fs-6 me-2"></i>
                                                    <span class="fs-5">@item.AppointmentDate.ToString("HH:mm")</span>
                                                </div>
                                                <span class="badge @badgeColor rounded-pill px-2 py-1" style="font-size: 0.75rem;">@statusTranslate</span>
                                            </div>
                                            <h6 class="fw-bold text-secondary mb-1">@item.CarMake @item.CarModel</h6>
                                            <div class="text-muted small mb-2">
                                                @(item.Service?.Name ?? "Nespecificat")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@functions {
    public string GetBadgeColor(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Accepted" => "bg-primary",
            "Done" => "bg-success",
            "Canceled" => "bg-danger",
            "Rejected" => "bg-secondary",
            "Rescheduled" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }

    public string TranslateStatus(string status)
    {
        return status switch
        {
            "Pending" => "În așteptare",
            "Accepted" => "Confirmată",
            "Done" => "Finalizată",
            "Canceled" => "Anulată",
            "Rejected" => "Respinsă",
            "Rescheduled" => "Reprogramată",
            _ => status
        };
    }
}

<style>
    .transition-all {
        transition: all 0.3s ease;
    }
    
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1)!important;
    }

    :root {
        --accent-color: #fd7e14; 
    }

    .transition-icon {
        transition: transform 0.3s ease;
    }
    
    [data-bs-toggle="collapse"][aria-expanded="true"] .transition-icon {
        transform: rotate(180deg);
    }
</style>