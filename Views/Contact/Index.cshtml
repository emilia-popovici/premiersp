@model IEnumerable<PremierAuto.Models.ContactMessage>

@{
    ViewData["Title"] = "Inbox";
    // Sistemul va folosi layout-ul de Admin doar dacă ai rolul respectiv
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout"; 
}

<div class="container mt-5 mb-5">
    <h2 class="text-navy fw-bold mb-4">Inbox: Mesaje de la Clienți</h2>
    
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12"><p class="text-muted fs-5">Nu ai niciun mesaj momentan.</p></div>
        }
        @foreach (var msg in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0 h-100 @(msg.IsRead ? "bg-light" : "border-start border-4 border-danger")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <h5 class="fw-bold text-navy mb-0">@msg.Name</h5>
                            <small class="text-muted">@msg.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <h6 class="text-danger fw-bold mb-3">📞 @msg.Phone</h6>
                        <p class="mb-0">@msg.Message</p>
                        
                        @if (!msg.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post" class="mt-3 text-end">
                                <input type="hidden" name="id" value="@msg.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Marchează ca rezolvat</button>
                            </form>
                        }
                        else
                        {
                            <div class="mt-3 text-end text-success fw-bold"><small>✓ Rezolvat</small></div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>