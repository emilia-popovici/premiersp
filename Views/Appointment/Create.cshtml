@model PremierAuto.ViewModels.AppointmentCreateViewModel

@{
    ViewData["Title"] = "Programează-te";
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5 bg-light">
                    <h2 class="text-center text-navy fw-bold mb-4">Creează o programare nouă</h2>

                    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold"></div>

                    <form asp-action="Create" method="post" id="appointmentForm">
                        <div class="mb-3">
                            <label asp-for="ServiceId" class="form-label fw-bold text-navy">Alege Serviciul</label>
                            <select asp-for="ServiceId" asp-items="Model.Services" class="form-select" required>
                                <option value="">-- Selectează un serviciu --</option>
                            </select>
                            <span asp-validation-for="ServiceId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MechanicId" class="form-label fw-bold text-navy">Alege mecanicul</label>
                            <select asp-for="MechanicId" asp-items="Model.Mechanics" class="form-select" id="mechanicSelect" required>
                                <option value="">-- Selectează un mecanic --</option>
                            </select>
                            <span asp-validation-for="MechanicId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-navy">Data programării</label>
                                <input type="text" id="appointmentDate" name="selectedDate" class="form-control rounded-3 border-light bg-light shadow-none" style="height: 56px;" placeholder="Se încarcă..." required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-navy">Ora programării</label>
                            <div id="timeSlotsContainer" class="d-flex flex-wrap gap-2 p-3 bg-white rounded border">
                                <span class="text-muted small">Selectează un mecanic și o dată pentru a vedea orele disponibile.</span>
                            </div>
                            <div class="form-text mt-2">Intervale disponibile: luni–vineri între 09:00-17:00.</div>
                            <input type="hidden" id="selectedTime" name="selectedTime" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CarMake" class="form-label fw-bold text-navy">Marca Mașinii</label>
                                <input asp-for="CarMake" class="form-control" list="carMakes" id="carMakeInput" placeholder="ex: Dacia" autocomplete="off" required />
                                <span asp-validation-for="CarMake" class="text-danger"></span>
                                
                                <datalist id="carMakes">
                                    <option value="Dacia"></option>
                                    <option value="Volkswagen"></option>
                                    <option value="BMW"></option>
                                    <option value="Audi"></option>
                                    <option value="Skoda"></option>
                                    <option value="Mercedes-Benz"></option>
                                    <option value="Renault"></option>
                                    <option value="Ford"></option>
                                    <option value="Toyota"></option>
                                    <option value="Hyundai"></option>
                                    <option value="Peugeot"></option>
                                    <option value="Opel"></option>
                                    <option value="Seat"></option>
                                    <option value="Kia"></option>
                                    <option value="Volvo"></option>
                                    <option value="Nissan"></option>
                                    <option value="Honda"></option>
                                    <option value="Mazda"></option>
                                    <option value="Suzuki"></option>
                                    <option value="Fiat"></option>
                                </datalist>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CarModel" class="form-label fw-bold text-navy">Modelul Mașinii</label>
                                <input asp-for="CarModel" class="form-control" list="carModels" id="carModelInput" placeholder="ex: Logan" autocomplete="off" required />
                                <span asp-validation-for="CarModel" class="text-danger"></span>
                                
                                <datalist id="carModels"></datalist>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold text-navy">Notițe (Simptome, Detalii problemă)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary-cta btn-lg fw-bold">Confirmă Programarea</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#ServiceId').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Caută și selectează un serviciu --',
                width: '100%',
                language: {
                    noResults: function () {
                        return "Nu am găsit niciun serviciu.";
                    }
                }
            });

            $('#ServiceId').on('select2:select', function (e) {
                this.dispatchEvent(new Event('change'));
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            const serviceSelect = document.getElementById('ServiceId');
            const mechanicSelect = document.getElementById('mechanicSelect');
            const dateInput = document.getElementById('appointmentDate');
            const timeSlotsContainer = document.getElementById('timeSlotsContainer');
            const selectedTimeInput = document.getElementById('selectedTime');

            function fetchAvailableHours() {
                const serviceId = serviceSelect.value;
                const mechanicId = mechanicSelect.value;
                const date = dateInput.value;

                if (!serviceId || !mechanicId || !date) {
                    timeSlotsContainer.innerHTML = '<span class="text-muted small">Selectează serviciul, mecanicul și data pentru a vedea orele disponibile.</span>';
                    return;
                }

                timeSlotsContainer.innerHTML = '<span class="spinner-border spinner-border-sm text-navy"></span> <span class="ms-2">Se calculează intervalele compatibile...</span>';

                fetch(`/Appointment/GetAvailableHours?mechanicId=${mechanicId}&serviceId=${serviceId}&date=${date}`)
                    .then(response => response.json())
                    .then(hours => {
                        timeSlotsContainer.innerHTML = '';
                        selectedTimeInput.value = '';

                        if (hours.length === 0) {
                            timeSlotsContainer.innerHTML = '<div class="alert alert-warning w-100 mb-0 py-2"><i class="bi bi-exclamation-triangle me-2"></i>Nu există un interval continuu suficient de mare pentru acest serviciu în data aleasă.</div>';
                            return;
                        }

                        hours.forEach(hour => {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'btn btn-outline-primary fw-bold';
                            btn.innerText = hour;
                            
                            btn.addEventListener('click', function () {
                                Array.from(timeSlotsContainer.children).forEach(c => c.classList.remove('active'));
                                this.classList.add('active');
                                selectedTimeInput.value = hour;
                            });

                            timeSlotsContainer.appendChild(btn);
                        });
                    })
                    .catch(error => {
                        console.error('Eroare AJAX:', error);
                        timeSlotsContainer.innerHTML = '<span class="text-danger small">A apărut o eroare la încărcarea orelor.</span>';
                    });
            }

            serviceSelect.addEventListener('change', fetchAvailableHours);
            mechanicSelect.addEventListener('change', fetchAvailableHours);
            dateInput.addEventListener('change', fetchAvailableHours);

            flatpickr("#appointmentDate", {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                minDate: "today",
                defaultDate: "today",
                locale: "ro",
                disable: [
                    function(date) {
                        return (date.getDay() === 0 || date.getDay() === 6);
                    }
                ],
                onChange: function(selectedDates, dateStr, instance) {
                    if (selectedDates.length > 0) {
                        document.getElementById('appointmentDate').dispatchEvent(new Event('change'));
                    }
                }
            });

            const carData = {
                "Dacia": ["Logan", "Duster", "Sandero", "Spring", "Jogger", "Dokker", "Lodgy"],
                "Volkswagen": ["Golf", "Passat", "Polo", "Tiguan", "Touareg", "Touran", "Jetta", "Arteon", "Caddy"],
                "BMW": ["Seria 3", "Seria 5", "Seria 1", "X3", "X5", "X1", "Seria 4", "Seria 7", "X6"],
                "Audi": ["A4", "A6", "A3", "Q5", "Q7", "A5", "Q3", "A8"],
                "Skoda": ["Octavia", "Superb", "Fabia", "Kodiaq", "Rapid", "Scala", "Kamiq", "Karoq"],
                "Renault": ["Clio", "Megane", "Captur", "Kadjar", "Symbol", "Laguna", "Talisman", "Twingo", "Trafic"],
                "Ford": ["Focus", "Fiesta", "Mondeo", "Kuga", "Puma", "Transit", "Ecosport", "Mustang"],
                "Mercedes-Benz": ["Clasa C", "Clasa E", "Clasa A", "GLE", "GLC", "Clasa S", "Vito", "Sprinter"],
                "Toyota": ["Corolla", "Yaris", "RAV4", "C-HR", "Camry", "Auris", "Avensis", "Hilux"],
                "Hyundai": ["Tucson", "i30", "i20", "Kona", "Santa Fe", "Elantra", "Accent"],
                "Peugeot": ["208", "308", "2008", "3008", "508", "5008", "Partner"],
                "Opel": ["Astra", "Corsa", "Insignia", "Mokka", "Crossland", "Zafira"],
                "Seat": ["Leon", "Ibiza", "Ateca", "Tarraco", "Arona"],
                "Kia": ["Sportage", "Ceed", "Rio", "Sorento", "Stonic"],
                "Volvo": ["XC60", "XC90", "XC40", "S90", "V90", "S60"],
                "Nissan": ["Qashqai", "Juke", "X-Trail", "Micra", "Leaf"],
                "Honda": ["Civic", "CR-V", "HR-V", "Accord"],
                "Mazda": ["Mazda3", "CX-5", "Mazda6", "CX-30", "CX-3"],
                "Suzuki": ["Vitara", "Swift", "SX4 S-Cross", "Ignis"],
                "Fiat": ["500", "Tipo", "Panda", "Ducato"]
            };

            const makeInput = document.getElementById("carMakeInput");
            const modelInput = document.getElementById("carModelInput");
            const modelsDatalist = document.getElementById("carModels");

            makeInput.addEventListener("input", function () {
                const selectedMake = this.value.trim();
                modelsDatalist.innerHTML = "";
                
                if (carData[selectedMake]) {
                    carData[selectedMake].forEach(function (model) {
                        const option = document.createElement("option");
                        option.value = model;
                        modelsDatalist.appendChild(option);
                    });
                }
            });
        });
    </script>
    
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}