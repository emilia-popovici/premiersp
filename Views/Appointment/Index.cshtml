@using PremierAuto.Models
@model IEnumerable<PremierAuto.Models.Appointment>
@{
    ViewData["Title"] = "Programări";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";

    string StatusLabel(AppointmentStatus s) => s switch
    {
        AppointmentStatus.Pending => "În așteptare",
        AppointmentStatus.Accepted => "Acceptată",
        AppointmentStatus.Rejected => "Refuzată",
        AppointmentStatus.Rescheduled => "Reprogramată",
        AppointmentStatus.Done => "Finalizată",
        AppointmentStatus.Canceled => "Anulată",
        _ => s.ToString()
    };

    string StatusBadgeClass(AppointmentStatus s) => s switch
    {
        AppointmentStatus.Pending => "bg-warning text-dark",
        AppointmentStatus.Accepted => "bg-primary",
        AppointmentStatus.Rejected => "bg-danger",
        AppointmentStatus.Rescheduled => "bg-info text-dark",
        AppointmentStatus.Done => "bg-success",
        AppointmentStatus.Canceled => "bg-secondary",
        _ => "bg-secondary"
    };

    string title = User.IsInRole("Admin") ? "Toate Programările"
        : User.IsInRole("Mecanic") ? "Programările Mele (Alocate)"
        : "Programările Mele";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-navy fw-bold mb-0">@title</h2>
        
        @if (User.IsInRole("Client"))
        {
            <a asp-controller="Appointment" asp-action="Create" class="btn btn-navy fw-bold shadow-sm">
                <i class="bi bi-plus-circle me-2"></i> Programare Nouă
            </a>
        }
    </div>

    @if (User.IsInRole("Mecanic") && ViewBag.NotLinked == true)
    {
        <div class="alert alert-warning fw-bold">
            Contul tău nu este încă legat de o fișă de mecanic. Cere administratorului să facă legătura din panoul de administrare.
        </div>
    }

    @if (!Model.Any() && ViewBag.NotLinked != true)
    {
        <p class="text-muted">Nu există programări de afișat momentan.</p>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm border-0 border-start border-4 @(item.Status == AppointmentStatus.Done ? "border-success" : item.Status == AppointmentStatus.Canceled || item.Status == AppointmentStatus.Rejected ? "border-secondary" : "border-primary")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="fw-bold">@item.Service.Name</h5>
                            <span class="badge @StatusBadgeClass(item.Status) fw-bold">@StatusLabel(item.Status)</span>
                        </div>
                        <p class="mb-1"><strong>Data:</strong> @item.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="mb-1"><strong>Mașină:</strong> @item.CarMake @item.CarModel</p>
                        <p class="mb-1"><strong>Mecanic:</strong> @(item.Mechanic != null ? $"{item.Mechanic.FirstName} {item.Mechanic.LastName}" : "În așteptare alocare")</p>
                        
                        @if (User.IsInRole("Admin") || User.IsInRole("Mecanic"))
                        {
                            <p class="mb-1"><strong>Client:</strong> @(item.Client != null ? item.Client.Email : "-")</p>
                        }
                        
                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <p class="mb-1 small text-muted"><strong>Notițe:</strong> @item.Notes</p>
                        }

                        @if (item.Status == AppointmentStatus.Done && item.FinalPrice.HasValue)
                        {
                            <div class="mt-3 p-2 bg-success bg-opacity-10 rounded border border-success border-opacity-25">
                                <span class="d-block small text-muted fw-bold mb-1">Detalii Intervenție:</span>
                                <span class="fw-bold text-dark"><i class="bi bi-clock-history me-1"></i> @item.FinalDurationMinutes minute</span> <span class="text-muted mx-1">|</span>
                                <span class="fw-bold text-success"><i class="bi bi-cash-coin me-1"></i> @item.FinalPrice MDL</span>
                            </div>
                            <div class="mt-2 mb-3">
                                <a asp-action="Chat" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary w-100">
                                    <i class="bi bi-chat-text"></i> Istoric Chat
                                </a>
                            </div>
                        }

                        @if (User.IsInRole("Client"))
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                @if (item.Status == AppointmentStatus.Pending || item.Status == AppointmentStatus.Accepted || item.Status == AppointmentStatus.Rescheduled)
                                {
                                    <a asp-controller="Appointment" asp-action="Chat" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-bold">
                                        <i class="bi bi-chat-dots me-1"></i> Discută cu Service-ul
                                    </a>
                                }

                                @if (item.Status == AppointmentStatus.Pending || item.Status == AppointmentStatus.Accepted || item.Status == AppointmentStatus.Rescheduled)
                                {
                                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Sigur vrei să anulezi această programare?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Anulează Programarea</button>
                                    </form>
                                }
                            </div>
                        }

                        @if (User.IsInRole("Mecanic") && item.Status == AppointmentStatus.Accepted)
                        {
                            <form asp-action="MarkAsDone" method="post" class="mt-3" onsubmit="return confirm('Confirmi că lucrarea a fost finalizată?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-success fw-bold">Marchează Finalizată</button>
                            </form>
                        }

                        @if (User.IsInRole("Client") && item.Status == AppointmentStatus.Done)
                        {
                            <hr />
                            @if (item.Review == null)
                            {
                                <form asp-controller="Review" asp-action="Save" method="post">
                                    <input type="hidden" name="appointmentId" value="@item.Id" />
                                    <select name="rating" class="form-select form-select-sm mb-2 w-50" required>
                                        <option value="5">5 Stele</option>
                                        <option value="4">4 Stele</option>
                                        <option value="3">3 Stele</option>
                                        <option value="2">2 Stele</option>
                                        <option value="1">1 Stea</option>
                                    </select>
                                    <textarea name="comment" class="form-control form-control-sm mb-2" required placeholder="Lasă o recenzie..."></textarea>
                                    <button type="submit" class="btn btn-sm btn-success fw-bold">Salvează Recenzia</button>
                                </form>
                            }
                            else
                            {
                                <div class="bg-light p-2 rounded">
                                    <p class="mb-1 text-warning fw-bold">⭐ @item.Review.Rating / 5</p>
                                    <p class="mb-2 small text-muted">@item.Review.Comment</p>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" data-bs-toggle="collapse" data-bs-target="#editReview@(item.Id)">Editează</button>
                                        <form asp-controller="Review" asp-action="Delete" method="post" onsubmit="return confirm('Ștergi recenzia?');">
                                            <input type="hidden" name="reviewId" value="@item.Review.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Șterge Recenzia</button>
                                        </form>
                                    </div>
                                    <div class="collapse mt-2" id="editReview@(item.Id)">
                                        <form asp-controller="Review" asp-action="Save" method="post">
                                            <input type="hidden" name="appointmentId" value="@item.Id" />
                                            <select name="rating" class="form-select form-select-sm mb-2 w-50">
                                                <option value="5" selected="@(item.Review.Rating == 5)">5 Stele</option>
                                                <option value="4" selected="@(item.Review.Rating == 4)">4 Stele</option>
                                                <option value="3" selected="@(item.Review.Rating == 3)">3 Stele</option>
                                                <option value="2" selected="@(item.Review.Rating == 2)">2 Stele</option>
                                                <option value="1" selected="@(item.Review.Rating == 1)">1 Stea</option>
                                            </select>
                                            <textarea name="comment" class="form-control form-control-sm mb-2">@item.Review.Comment</textarea>
                                            <button type="submit" class="btn btn-sm btn-success fw-bold">Actualizează Recenzia</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>