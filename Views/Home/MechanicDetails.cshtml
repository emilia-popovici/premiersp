@model PremierAuto.Models.Mechanic

@{
    ViewData["Title"] = $"Profil Mecanic - {Model.FirstName} {Model.LastName}";
    var reviews = ViewBag.Reviews as List<PremierAuto.Models.Review>;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 p-4 bg-white">
                <div class="d-flex align-items-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                    {
                        <img src="@Model.PhotoUrl" alt="@Model.FirstName @Model.LastName" class="rounded-circle me-4" style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-4" style="width: 100px; height: 100px; font-size: 2.5rem;">🔧</div>
                    }
                    <div>
                        <h2 class="fw-bold text-navy mb-1">@Model.FirstName @Model.LastName</h2>
                        @if (reviews != null && reviews.Any())
                        {
                            <div class="text-warning d-flex align-items-center gap-1">
                                <span class="fw-bold text-dark me-1">@Model.Rating.ToString("0.0")</span>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= Math.Round(Model.Rating) ? "-fill" : "")"></i>
                                }
                                <span class="text-muted ms-2 small">(@reviews.Count recenzii)</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small"><i class="bi bi-star text-secondary me-1"></i> Fără recenzii momentan</span>
                        }
                    </div>
                </div>

                <hr class="my-4" />

                <h5 class="fw-bold text-navy mb-3">Recenzii și Evaluări</h5>

                @if (reviews != null && reviews.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var review in reviews)
                        {
                            <div class="card bg-light border-0 p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-navy">
                                        <i class="bi bi-person-circle me-1"></i> Client
                                    </span>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi bi-star@(i <= review.Rating ? "-fill" : "")"></i>
                                        }
                                    </div>
                                </div>
                                <p class="mb-0 text-muted">@review.Comment</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="bg-light p-4 rounded text-center text-muted">
                        <i class="bi bi-chat-square-text fs-3 mb-2 d-block text-secondary"></i>
                        Nu există recenzii adăugate încă pentru acest mecanic.
                    </div>
                }

                <div class="mt-4 text-start">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold">
                        <i class="bi bi-arrow-left me-1"></i> Înapoi la Acasă
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>