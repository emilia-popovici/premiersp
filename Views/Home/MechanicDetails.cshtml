@model PremierAuto.Models.Mechanic

@{
    ViewData["Title"] = $"Detalii Mecanic: {Model.FirstName} {Model.LastName}";
    var reviews = ViewBag.Reviews as List<PremierAuto.Models.Review>;
}

<div class="container py-5 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-4 fw-bold">
        <i class="bi bi-arrow-left me-1"></i> Înapoi la pagina princilă
    </a>

    <div class="row g-4 align-items-center mb-5">
        <div class="col-12 col-md-5 text-center text-md-start">
            <div class="position-relative d-inline-block">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" 
                                        alt="Poza @Model.FirstName" 
                                        class="mechanic-avatar mx-auto mb-3 rounded-circle bg-white" 
                                        style="width: 100px; height: 100px; object-fit: cover;" 
                                        onerror="this.onerror=null; this.src='/images/default-avatar.svg';" />
                }
                else
                {
                    <div class="rounded shadow bg-light border d-flex align-items-center justify-content-center mx-auto mx-md-0 text-secondary" style="width: 250px; height: 250px; font-size: 8rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success fs-6 shadow">
                    @Model.Rating.ToString("0.0") <i class="bi bi-star-fill text-warning"></i>
                </span>
            </div>
        </div>

        <div class="col-12 col-md-7">
            <div class="section-kicker">Profil Mecanic</div>
            <h1 class="fw-bold text-navy mb-3">@Model.FirstName @Model.LastName</h1>
            
            <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center justify-content-md-start">
                <span class="badge bg-light text-dark border p-2"><i class="bi bi-check-circle-fill text-success me-1"></i> Mecanic Verificat</span>
                <span class="badge bg-light text-dark border p-2"><i class="bi bi-briefcase-fill text-navy me-1"></i> Experiență Premium</span>
            </div>

            <p class="text-muted mb-4 lead" style="text-align: justify;">
                Bazează-te pe experiența și profesionalismul echipei noastre. Programările se realizează rapid, iar mașina ta ajunge pe mâini sigure.
            </p>

            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a asp-controller="Appointment" asp-action="Create" asp-route-mechanicId="@Model.Id" class="btn btn-primary-cta btn-lg fw-bold px-5">
                    Programează-te la acest mecanic
                </a>
            </div>
        </div>
    </div>

    <hr class="text-muted my-5 opacity-25" />
    
    <h3 class="fw-bold text-navy mb-4"><i class="bi bi-chat-quote-fill text-accent me-2"></i> Recenziile Clienților</h3>
    
    <div class="row g-4">
        @if (reviews != null && reviews.Any())
        {
            foreach (var review in reviews)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm p-4" style="background-color: var(--paper);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-navy text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                    C
                                </div>
                                <div>
                                    <div class="fw-bold text-dark mb-0">Client</div>
                                    <small class="text-muted">Recenzie verificată</small>
                                </div>
                            </div>
                            <div class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                        </div>
                        <p class="text-muted fst-italic mb-0">"@review.Comment"</p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border text-center text-muted p-4 shadow-sm">
                    Acest mecanic nu are încă nicio recenzie. Fii primul care lasă una după ce finalizezi o programare!
                </div>
            </div>
        }
    </div>
</div>