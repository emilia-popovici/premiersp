@model PremierAuto.Models.Mechanic

@{
    ViewData["Title"] = $"Detalii Mecanic: {Model.FirstName} {Model.LastName}";
}

<div class="container py-5 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-4 fw-bold">
        <i class="bi bi-arrow-left me-1"></i> Înapoi la acasă
    </a>

    <div class="row g-4 align-items-center">
        <div class="col-12 col-md-5 text-center text-md-start">
            <div class="position-relative d-inline-block">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="Poza @Model.FirstName" class="img-fluid rounded shadow" style="max-width: 300px; width: 100%; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded shadow bg-light d-flex align-items-center justify-content-center mx-auto mx-md-0" style="width: 250px; height: 250px; font-size: 5rem;">
                        🔧
                    </div>
                }
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success fs-6 shadow">
                    @Model.Rating.ToString("0.0") <i class="bi bi-star-fill text-warning"></i>
                </span>
            </div>
        </div>

        <div class="col-12 col-md-7">
            <div class="section-kicker">Profil Mecanic</div>
            <h1 class="fw-bold text-navy mb-3">@Model.FirstName @Model.LastName</h1>
            
            <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center justify-content-md-start">
                <span class="badge bg-light text-dark border p-2"><i class="bi bi-check-circle-fill text-success me-1"></i> Mecanic Verificat</span>
                <span class="badge bg-light text-dark border p-2"><i class="bi bi-briefcase-fill text-navy me-1"></i> Experiență Premium</span>
            </div>

            <p class="text-muted mb-4 lead" style="text-align: justify;">
                Bazează-te pe experiența și profesionalismul echipei noastre. Programările se realizează rapid, iar mașina ta ajunge pe mâini sigure.
            </p>

            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a asp-controller="Appointment" asp-action="Create" asp-route-mechanicId="@Model.Id" class="btn btn-primary-cta btn-lg fw-bold px-5">
                    Programează-te la acest mecanic
                </a>
            </div>
        </div>
    </div>
</div>