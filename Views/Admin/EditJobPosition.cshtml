@model PremierAuto.Models.JobPosition
@{
    ViewData["Title"] = "Editează Post";
    Layout = "_AdminLayout";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-navy text-white p-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Editează postul: @Model.Title</h4>
        </div>
        <div class="card-body p-4 bg-light">
            <form asp-action="EditJobPosition" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold text-navy">Titlu Job</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold text-navy">Scurtă Descriere</label>
                    <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                </div>
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsHiring">
                    <label class="form-check-label fw-bold text-success" asp-for="IsHiring">Acest post este activ (Angajăm)</label>
                </div>
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="JobPositions" class="btn btn-outline-secondary fw-bold">Înapoi</a>
                    <button type="submit" class="btn btn-primary-cta fw-bold">Actualizează</button>
                </div>
            </form>
        </div>
    </div>
</div>