@{
    ViewData["Title"] = "Dashboard Statistici";
    Layout = "_AdminLayout";
    var stats = ViewBag.DistributionData as IEnumerable<dynamic>;
    var totalApp = ViewBag.TotalAppointments != null ? (int)ViewBag.TotalAppointments : 0;
}

<div class="row">
    <!-- card KPI -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100 py-2">
            <div class="card-body">
                <div class="text-xs fw-bold text-primary text-uppercase mb-1">Programări Noi</div>
                <div class="h3 mb-0 fw-bold text-dark">@ViewBag.PendingAppointmentsCount</div>
            </div>
        </div>
    </div>

    <!--card notificari-->
    <div class="col-md-3 mb-4">
        <a asp-controller="Admin" asp-action="AllChats" class="text-decoration-none">
            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100 py-2 hover-effect" style="transition: transform 0.2s;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1">Mesaje de la Clienți</div>
                        <i class="bi bi-chat-dots-fill fs-4 text-warning"></i>
                    </div>
                    <div class="h3 mb-0 fw-bold text-dark">@(ViewBag.UnreadMessagesCount ?? 0)</div>
                    <small class="text-muted">Click pentru a vedea chat-urile</small>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- distributie servicii si performanta -->
<div class="row g-4 mt-2">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4 border-start border-4 border-primary">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3" data-bs-toggle="collapse" href="#collapseServices" role="button" aria-expanded="true" style="cursor: pointer;">
                <h5 class="fw-bold text-primary mb-0">
                    <i class="bi bi-pie-chart-fill me-2"></i> Statistici Servicii
                </h5>
                <i class="bi bi-chevron-down text-muted"></i>
            </div>
            <div class="collapse show" id="collapseServices">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-navy">
                                <tr>
                                    <th class="py-3 px-4">Serviciu</th>
                                    <th class="py-3 text-center">Frecvență</th>
                                    <th class="py-3 text-end px-4">Venit Generat</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.DistributionData != null)
                                {
                                    foreach (var item in ViewBag.DistributionData)
                                    {
                                        <tr>
                                            <td class="px-4 fw-bold text-navy">@item.ServiceName</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">@item.Count prog. (@item.Percentage%)</span>
                                            </td>
                                            <td class="text-end px-4 fw-bold text-success">@item.TotalRevenue MDL</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- kpi mecanici -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4 border-start border-4 border-success">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3" data-bs-toggle="collapse" href="#collapseMechanics" role="button" aria-expanded="true" style="cursor: pointer;">
                <h5 class="fw-bold text-success mb-0">
                    <i class="bi bi-person-workspace me-2"></i> Performanță Mecanici
                </h5>
                <i class="bi bi-chevron-down text-muted"></i>
            </div>
            <div class="collapse show" id="collapseMechanics">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-navy">
                                <tr>
                                    <th class="py-3 px-4">Mecanic</th>
                                    <th class="py-3 text-center">Mașini Finalizate</th>
                                    <th class="py-3 text-end px-4">Venit Total Generat</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.MechanicKPIs != null)
                                {
                                    foreach (var mechanic in ViewBag.MechanicKPIs)
                                    {
                                        <tr>
                                            <td class="px-4 fw-bold text-navy">
                                                <i class="bi bi-wrench-adjustable text-muted me-1"></i> @mechanic.MechanicName
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success">@mechanic.CompletedJobs</span>
                                            </td>
                                            <td class="text-end px-4 fw-bold text-success">@mechanic.TotalGeneratedRevenue MDL</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(function(el) {
            el.addEventListener('click', function() {
                var icon = this.querySelector('.bi-chevron-down, .bi-chevron-up');
                if(icon) {
                    icon.classList.toggle('bi-chevron-down');
                    icon.classList.toggle('bi-chevron-up');
                }
            });
        });
    </script>
}