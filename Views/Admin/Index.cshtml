@{
    ViewData["Title"] = "Dashboard Statistici";
    Layout = "_AdminLayout"; // Forțăm utilizarea noului layout
    var stats = ViewBag.DistributionData as IEnumerable<dynamic>;
    var totalApp = ViewBag.TotalAppointments != null ? (int)ViewBag.TotalAppointments : 0;
}

<div class="row">
    <!-- Card KPI Placeholder 1 -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100 py-2">
            <div class="card-body">
                <div class="text-xs fw-bold text-primary text-uppercase mb-1">Programări Noi</div>
                <div class="h3 mb-0 fw-bold text-dark">@ViewBag.PendingAppointmentsCount</div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- DISTRIBUȚIA SERVICIILOR & PERFORMANȚĂ -->
<!-- ========================================== -->
<div class="card shadow-sm border-0 mt-4 bg-white">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold text-navy"><i class="bi bi-pie-chart-fill me-2"></i> Distribuția Serviciilor și Performanță</h6>
        <a asp-controller="Admin" asp-action="Services" class="btn btn-sm btn-outline-secondary fw-bold">
            <i class="bi bi-gear me-1"></i> Gestionează Serviciile
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-navy">
                    <tr>
                        <th class="py-3 px-3">Nume Serviciu</th>
                        <th class="py-3">Preț Standard</th>
                        <th class="py-3 text-center">Număr Programări</th>
                        <th class="py-3">Pondere din total</th>
                        <th class="py-3 text-end px-3">Venit Realizat (Finalizate)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (stats == null || !stats.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Nu există date suficiente pentru statistică momentan.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in stats)
                        {
                            <tr>
                                <td class="px-3">
                                    <span class="fw-bold text-navy">@item.ServiceName</span><br />
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>
                                    <span class="fw-bold">@item.Price.ToString("0.00") LEI</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary fs-6 px-3 py-1">@item.Count</span>
                                </td>
                                <td style="width: 25%;">
                                    @{
                                        // Asigurăm un procent maxim de 100% pentru bară, indiferent de valoare
                                        double rawPct = Convert.ToDouble(item.Percentage);
                                        double displayPct = rawPct > 100 ? rawPct / 5 : rawPct; // Sau transformă direct dacă e cazul
                                        if (displayPct > 100) displayPct = 100;
                                    }
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @displayPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@displayPct" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <small class="fw-bold text-muted">@rawPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</small>
                                    </div>
                                </td>
                                <td class="text-end px-3">
                                    <span class="fw-bold text-success">@item.TotalRevenue.ToString("0.00") LEI</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>