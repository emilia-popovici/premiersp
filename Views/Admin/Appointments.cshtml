@using PremierAuto.Models
@model IEnumerable<PremierAuto.Models.Appointment>
@{
    ViewData["Title"] = "Gestionare Programări";
    Layout = "_AdminLayout";

    string StatusLabel(AppointmentStatus s) => s switch
    {
        AppointmentStatus.Pending => "În așteptare",
        AppointmentStatus.Accepted => "Acceptată",
        AppointmentStatus.Rejected => "Refuzată",
        AppointmentStatus.Rescheduled => "Reprogramată",
        AppointmentStatus.Done => "Finalizată",
        AppointmentStatus.Canceled => "Anulată",
        _ => s.ToString()
    };

    var startOfWeek = (DateTime)ViewBag.StartOfWeek;
    var endOfWeek = (DateTime)ViewBag.EndOfWeek;

    var pendingList = Model.Where(a => a.Status == AppointmentStatus.Pending).OrderBy(a => a.AppointmentDate).ToList();
    
    var currentWeekList = Model.Where(a => (a.Status == AppointmentStatus.Accepted || a.Status == AppointmentStatus.Rescheduled) 
        && a.AppointmentDate.Date >= startOfWeek && a.AppointmentDate.Date <= endOfWeek).OrderBy(a => a.AppointmentDate).ToList();

    var otherActiveList = Model.Where(a => (a.Status == AppointmentStatus.Accepted || a.Status == AppointmentStatus.Rescheduled) 
        && (a.AppointmentDate.Date < startOfWeek || a.AppointmentDate.Date > endOfWeek)).OrderBy(a => a.AppointmentDate).ToList();

    var historyList = Model.Where(a => a.Status == AppointmentStatus.Done || a.Status == AppointmentStatus.Rejected || a.Status == AppointmentStatus.Canceled).OrderByDescending(a => a.AppointmentDate).ToList();
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-navy fw-bold mb-0">Panou Programări</h2>
        <button type="button" class="btn btn-primary-cta fw-bold" data-bs-toggle="modal" data-bs-target="#adminCreateAppointmentModal">
            <i class="bi bi-plus-lg me-2"></i> Adaugă Programare Manuală
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fw-bold alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger fw-bold alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- search bar -->
    <div class="card shadow-sm border-0 bg-white p-3 mb-4">
        <form method="get" asp-action="Appointments" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Caută (Client / Mașină)</label>
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Nume, email sau mașină..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Filtrează după Mecanic</label>
                <select name="mechanicId" class="form-select">
                    <option value="">Toți mecanicii</option>
                    @foreach (var mech in (IEnumerable<Mechanic>)ViewBag.Mechanics)
                    {
                        <option value="@mech.Id" selected="@(ViewBag.SelectedMechanic == mech.Id.ToString())">@mech.FirstName @mech.LastName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">Filtrează după Serviciu</label>
                <select name="serviceId" class="form-select">
                    <option value="">Toate serviciile</option>
                    @foreach (var srv in (IEnumerable<Service>)ViewBag.Services)
                    {
                        <option value="@srv.Id" selected="@(ViewBag.SelectedService?.ToString() == srv.Id.ToString())">@srv.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">Dată specifică</label>
                <input type="text" id="adminDateFilter" name="dateFilter" value="@ViewBag.SelectedDate" class="form-control" placeholder="Selectează data..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary-cta w-100 fw-bold"><i class="bi bi-search"></i></button>
                <a asp-action="Appointments" class="btn btn-outline-secondary w-100 fw-bold" title="Resetează filtrele"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <!-- pending -->
    <div class="card shadow-sm border-0 mb-4 border-start border-4 border-warning">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3" data-bs-toggle="collapse" href="#collapsePending" role="button" aria-expanded="true" style="cursor: pointer;">
            <h4 class="fw-bold text-warning mb-0">
                <i class="bi bi-hourglass-split me-2"></i> Necesită Aprobare 
                <span class="badge bg-warning text-dark ms-2">@pendingList.Count</span>
            </h4>
            <i class="bi bi-chevron-down fs-5 text-muted"></i>
        </div>
        <div class="collapse show" id="collapsePending">
            <div class="card-body p-0">
                <div class="table-responsive mb-0">
                    <table class="table table-hover align-middle mb-0" style="min-width: 1000px;">
                        <thead class="bg-light text-navy">
                            <tr>
                                <th class="py-3 px-3">Data & Ora</th>
                                <th class="py-3">Client</th>
                                <th class="py-3">Serviciu / Mecanic</th>
                                <th class="py-3">Mașină</th>
                                <th class="py-3 text-center">Acțiuni & Chat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!pendingList.Any())
                            {
                               <tr><td colspan="5" class="text-center text-muted py-4">Nu există programări în așteptare.</td></tr>
                            }
                            @foreach (var app in pendingList)
                            {
                                <tr>
                                    <td class="px-3 text-nowrap">
                                        <span class="fw-bold text-navy">@app.AppointmentDate.ToString("dd/MM/yyyy")</span><br />
                                        <small class="text-muted"><i class="bi bi-clock"></i> @app.AppointmentDate.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-nowrap">
                                        <span class="fw-bold">@app.Client?.FirstName @app.Client?.LastName</span><br />
                                        <small class="text-muted"><i class="bi bi-telephone"></i> @(string.IsNullOrEmpty(app.Client?.PhoneNumber) ? "Fără telefon" : app.Client.PhoneNumber)</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border text-wrap">@app.Service?.Name</span><br />
                                        <small class="text-muted text-nowrap">Mecanic: @(app.Mechanic != null ? $"{app.Mechanic.FirstName} {app.Mechanic.LastName}" : "Neselectat")</small>
                                    </td>
                                    <td class="text-nowrap">@app.CarMake @app.CarModel</td>
                                    <td class="text-center text-nowrap">
                                        <div class="d-flex justify-content-center gap-1 flex-nowrap">
                                            <form asp-controller="Admin" asp-action="ChangeAppointmentStatus" method="post">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="status" value="Accepted" />
                                                <button type="submit" class="btn btn-sm btn-success fw-bold">Acceptă</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-warning fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#reschedule@(app.Id)">Reprogramează</button>
                                            <form asp-controller="Admin" asp-action="ChangeAppointmentStatus" method="post">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="status" value="Rejected" />
                                                <button type="submit" class="btn btn-sm btn-danger fw-bold">Refuză</button>
                                            </form>
                                            <a asp-controller="Admin" asp-action="AppointmentChat" asp-route-id="@app.Id" class="btn btn-sm btn-outline-info fw-bold">
                                                <i class="bi bi-chat-dots"></i> Chat
                                            </a>
                                        </div>

                                        <!-- modal reprogramare -->
                                        <div class="modal fade text-start" id="reschedule@(app.Id)" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <form asp-controller="Admin" asp-action="RescheduleAppointment" method="post" class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold text-navy">Reprogramează programarea</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@app.Id" />
                                                        <label class="form-label fw-bold">Dată și oră nouă</label>
                                                        <input type="text" name="newDate" class="form-control flatpickr-datetime" value="@app.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" required />
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Anulează</button>
                                                        <button type="submit" class="btn btn-primary-cta fw-bold">Salvează</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- programari curente -->
    <div class="card shadow-sm border-0 mb-4 border-start border-4 border-primary">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center py-3 gap-2">
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center flex-wrap">
                <i class="bi bi-calendar-week me-2"></i> Săptămâna Aceasta 
                <span class="badge bg-primary ms-2 me-2">@currentWeekList.Count</span>
                <span class="text-muted fs-6 fw-normal">(@startOfWeek.ToString("dd.MM") - @endOfWeek.ToString("dd.MM"))</span>
            </h4>
            <div class="btn-group" role="group">
                <a asp-action="Appointments" asp-route-weekDate="@ViewBag.PrevWeekDate" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-mechanicId="@ViewBag.SelectedMechanic" asp-route-serviceId="@ViewBag.SelectedService" class="btn btn-outline-primary btn-sm fw-bold">
                    <i class="bi bi-chevron-left"></i> Săpt. Anterioară
                </a>
                <a asp-action="Appointments" asp-route-weekDate="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm fw-bold" title="Săptămâna curentă">
                    Astăzi
                </a>
                <a asp-action="Appointments" asp-route-weekDate="@ViewBag.NextWeekDate" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-mechanicId="@ViewBag.SelectedMechanic" asp-route-serviceId="@ViewBag.SelectedService" class="btn btn-outline-primary btn-sm fw-bold">
                    Săpt. Următoare <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
        <div>
            <div class="card-body p-0">
                <div class="table-responsive mb-0">
                    <table class="table table-hover align-middle mb-0" style="min-width: 1000px;">
                        <thead class="bg-light text-navy">
                            <tr>
                                <th class="py-3 px-3">Data & Ora</th>
                                <th class="py-3">Client</th>
                                <th class="py-3">Serviciu / Mecanic</th>
                                <th class="py-3">Mașină</th>
                                <th class="py-3 text-center">Status / Acțiuni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!currentWeekList.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">Nu există programări active în această săptămână.</td></tr>
                            }
                            @foreach (var app in currentWeekList)
                            {
                                <tr>
                                    <td class="px-3 text-nowrap">
                                        <span class="fw-bold text-navy">@app.AppointmentDate.ToString("dd/MM/yyyy")</span><br />
                                        <small class="text-muted"><i class="bi bi-clock"></i> @app.AppointmentDate.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-nowrap">
                                        <span class="fw-bold">@app.Client?.FirstName @app.Client?.LastName</span><br />
                                        <small class="text-muted"><i class="bi bi-telephone"></i> @(string.IsNullOrEmpty(app.Client?.PhoneNumber) ? "Fără telefon" : app.Client.PhoneNumber)</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border text-wrap">@app.Service?.Name</span><br />
                                        <small class="text-muted text-nowrap">Mecanic: @(app.Mechanic != null ? $"{app.Mechanic.FirstName} {app.Mechanic.LastName}" : "Neselectat")</small>
                                    </td>
                                    <td class="text-nowrap">@app.CarMake @app.CarModel</td>
                                    <td class="text-center text-nowrap">
                                        <span class="badge bg-success px-2 py-1 mb-2 d-inline-block">@StatusLabel(app.Status)</span>
                                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                                            <button type="button" class="btn btn-sm btn-outline-success fw-bold" data-bs-toggle="modal" data-bs-target="#completeApp@(app.Id)" title="Finalizează">
                                                <i class="bi bi-check2-circle"></i>
                                            </button>
                                            <div class="modal fade text-start" id="completeApp@(app.Id)" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <form asp-controller="Admin" asp-action="CompleteAppointment" method="post" class="modal-content border-success">
                                                        <div class="modal-header bg-success bg-opacity-10">
                                                            <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i>Finalizează Programarea</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="id" value="@app.Id" />
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Durată manoperă (minute)</label>
                                                                <input type="number" name="duration" class="form-control" placeholder="ex: 120" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Preț final (MDL)</label>
                                                                <div class="input-group">
                                                                    <input type="number" step="0.01" name="price" class="form-control" placeholder="ex: 900" required />
                                                                    <span class="input-group-text fw-bold">MDL</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Anulează</button>
                                                            <button type="submit" class="btn btn-success fw-bold">Salvează & Finalizează</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-warning fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#reschedule@(app.Id)" title="Reprogramează">
                                                <i class="bi bi-calendar-event"></i>
                                            </button>
                                            <form asp-controller="Admin" asp-action="ChangeAppointmentStatus" method="post">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="status" value="Canceled" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" onclick="return confirm('Ești sigur că vrei să anulezi programarea?');" title="Anulează">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                            <a asp-controller="Admin" asp-action="AppointmentChat" asp-route-id="@app.Id" class="btn btn-sm btn-outline-info fw-bold" title="Chat">
                                                <i class="bi bi-chat-dots"></i>
                                            </a>
                                        </div>

                                        <!-- modal reprogramare pt saptamana curenta -->
                                        <div class="modal fade text-start" id="reschedule@(app.Id)" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <form asp-controller="Admin" asp-action="RescheduleAppointment" method="post" class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold text-navy">Reprogramează programarea</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@app.Id" />
                                                        <label class="form-label fw-bold">Dată și oră nouă</label>
                                                        <input type="text" name="newDate" class="form-control flatpickr-datetime" value="@app.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" required />
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Anulează</button>
                                                        <button type="submit" class="btn btn-primary-cta fw-bold">Salvează</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- programari active -->
    <div class="card shadow-sm border-0 mb-4 border-start border-4 border-info">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3" data-bs-toggle="collapse" href="#collapseOther" role="button" aria-expanded="false" style="cursor: pointer;">
            <h4 class="fw-bold text-info mb-0">
                <i class="bi bi-calendar-range me-2"></i> Alte Programări active 
                <span class="badge bg-info text-dark ms-2">@otherActiveList.Count</span>
            </h4>
            <i class="bi bi-chevron-down fs-5 text-muted"></i>
        </div>
        <div class="collapse" id="collapseOther">
            <div class="card-body p-0">
                <div class="table-responsive mb-0">
                    <table class="table table-hover align-middle mb-0" style="min-width: 1000px;">
                        <thead class="bg-light text-navy">
                            <tr>
                                <th class="py-3 px-3">Data & Ora</th>
                                <th class="py-3">Client</th>
                                <th class="py-3">Serviciu / Mecanic</th>
                                <th class="py-3">Mașină</th>
                                <th class="py-3 text-center">Status / Acțiuni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!otherActiveList.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">Nu există alte programări active.</td></tr>
                            }
                            @foreach (var app in otherActiveList)
                            {
                                <tr>
                                    <td class="px-3 text-nowrap">
                                        <span class="fw-bold text-navy">@app.AppointmentDate.ToString("dd/MM/yyyy")</span><br />
                                        <small class="text-muted"><i class="bi bi-clock"></i> @app.AppointmentDate.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-nowrap">
                                        <span class="fw-bold">@app.Client?.FirstName @app.Client?.LastName</span><br />
                                        <small class="text-muted"><i class="bi bi-telephone"></i> @(string.IsNullOrEmpty(app.Client?.PhoneNumber) ? "Fără telefon" : app.Client.PhoneNumber)</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border text-wrap">@app.Service?.Name</span><br />
                                        <small class="text-muted text-nowrap">Mecanic: @(app.Mechanic != null ? $"{app.Mechanic.FirstName} {app.Mechanic.LastName}" : "Neselectat")</small>
                                    </td>
                                    <td class="text-nowrap">@app.CarMake @app.CarModel</td>
                                    <td class="text-center text-nowrap">
                                        <span class="badge bg-info text-dark px-2 py-1 mb-2 d-inline-block">@StatusLabel(app.Status)</span>
                                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                                            <button type="button" class="btn btn-sm btn-outline-success fw-bold" data-bs-toggle="modal" data-bs-target="#completeApp@(app.Id)" title="Finalizează">
                                                <i class="bi bi-check2-circle"></i>
                                            </button>
                                            <div class="modal fade text-start" id="completeApp@(app.Id)" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <form asp-controller="Admin" asp-action="CompleteAppointment" method="post" class="modal-content border-success">
                                                        <div class="modal-header bg-success bg-opacity-10">
                                                            <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i>Finalizează Programarea</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="id" value="@app.Id" />
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Durată manoperă (minute)</label>
                                                                <input type="number" name="duration" class="form-control" placeholder="ex: 120" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Preț final (MDL)</label>
                                                                <div class="input-group">
                                                                    <input type="number" step="0.01" name="price" class="form-control" placeholder="ex: 900" required />
                                                                    <span class="input-group-text fw-bold">MDL</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Anulează</button>
                                                            <button type="submit" class="btn btn-success fw-bold">Salvează & Finalizează</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-warning fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#rescheduleOther@(app.Id)" title="Reprogramează">
                                                <i class="bi bi-calendar-event"></i>
                                            </button>
                                            <form asp-controller="Admin" asp-action="ChangeAppointmentStatus" method="post">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="status" value="Canceled" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" onclick="return confirm('Ești sigur că vrei să anulezi programarea?');" title="Anulează">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                            <a asp-controller="Admin" asp-action="AppointmentChat" asp-route-id="@app.Id" class="btn btn-sm btn-outline-info fw-bold" title="Chat">
                                                <i class="bi bi-chat-dots"></i>
                                            </a>
                                        </div>

                                        <!-- modal reprogramare pt alte programari active -->
                                        <div class="modal fade text-start" id="rescheduleOther@(app.Id)" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <form asp-controller="Admin" asp-action="RescheduleAppointment" method="post" class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold text-navy">Reprogramează programarea</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@app.Id" />
                                                        <label class="form-label fw-bold">Dată și oră nouă</label>
                                                        <input type="text" name="newDate" class="form-control flatpickr-datetime" value="@app.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" required />
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Anulează</button>
                                                        <button type="submit" class="btn btn-primary-cta fw-bold">Salvează</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- istoric -->
    <div class="card shadow-sm border-0 mb-4 border-start border-4 border-secondary">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3" data-bs-toggle="collapse" href="#collapseHistory" role="button" aria-expanded="false" style="cursor: pointer;">
            <h4 class="fw-bold text-secondary mb-0">
                <i class="bi bi-archive me-2"></i> Istoric 
                <span class="badge bg-secondary ms-2">@historyList.Count</span>
            </h4>
            <i class="bi bi-chevron-down fs-5 text-muted"></i>
        </div>
        <div class="collapse" id="collapseHistory">
            <div class="card-body p-0">
                <div class="table-responsive mb-0">
                    <table class="table table-hover align-middle mb-0" style="min-width: 1100px;">
                        <thead class="bg-light text-navy">
                            <tr>
                                <th class="py-3 px-3">Data & Ora</th>
                                <th class="py-3">Client</th>
                                <th class="py-3">Serviciu / Mecanic</th>
                                <th class="py-3">Mașină</th>
                                <th class="py-3 text-center">Preț Final</th>
                                <th class="py-3 text-center">Notițe</th>
                                <th class="py-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!historyList.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">Nu există istoric.</td></tr>
                            }
                            @foreach (var app in historyList)
                            {
                                <tr>
                                    <td class="px-3 text-nowrap">
                                        <span class="text-muted">@app.AppointmentDate.ToString("dd/MM/yyyy")</span><br />
                                        <small class="text-muted"><i class="bi bi-clock"></i> @app.AppointmentDate.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-nowrap">
                                        <span class="fw-bold">@app.Client?.FirstName @app.Client?.LastName</span><br />
                                        <small class="text-muted"><i class="bi bi-telephone"></i> @(string.IsNullOrEmpty(app.Client?.PhoneNumber) ? "Fără telefon" : app.Client.PhoneNumber)</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border text-wrap">@app.Service?.Name</span><br />
                                        <small class="text-muted text-nowrap">Mecanic: @(app.Mechanic != null ? $"{app.Mechanic.FirstName} {app.Mechanic.LastName}" : "Neselectat")</small>
                                    </td>
                                    <td class="text-nowrap">@app.CarMake @app.CarModel</td>
                                    
                                    <td class="text-center text-nowrap">
                                        @if (app.FinalPrice.HasValue)
                                        {
                                            <span class="fw-bold text-success">@app.FinalPrice MDL</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(app.Notes))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#notesHistory-@app.Id" title="Vezi Notițele">
                                                <i class="bi bi-journal-text"></i>
                                            </button>

                                            <div class="modal fade text-start" id="notesHistory-@app.Id" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-light">
                                                            <h5 class="modal-title fw-bold text-navy"><i class="bi bi-info-circle me-2"></i>Notițe Programare</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body text-wrap text-break">
                                                            @app.Notes
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Închide</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>

                                    <td class="text-center text-nowrap">
                                        <span class="badge @(app.Status == AppointmentStatus.Done ? "bg-success" : "bg-danger") px-2 py-1">@StatusLabel(app.Status)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- programare manuala -->
<div class="modal fade text-start" id="adminCreateAppointmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form asp-action="CreateAppointment" method="post" class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-navy"><i class="bi bi-calendar-plus me-2"></i>Adaugă Programare Nouă (Admin)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                
                <h6 class="text-navy fw-bold mb-3"><i class="bi bi-person-badge me-2"></i>Informații Client</h6>
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold small text-muted">Caută cont existent (Opțional - auto-completează datele)</label>
                        <select name="clientId" id="clientSelectDropdown" class="form-select">
                            <option value="">Client fără cont sau introducere manuală</option>
                            @foreach (var c in (IEnumerable<PremierAuto.Controllers.ClientUserViewModel>)ViewBag.Clients ?? new List<PremierAuto.Controllers.ClientUserViewModel>())
                            {
                                <option value="@c.UserId" data-firstname="@c.FirstName" data-lastname="@c.LastName" data-phone="@c.PhoneNumber">
                                    @c.FirstName @c.LastName (@c.Email)
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-navy">Prenume Client</label>
                        <input type="text" name="clientFirstName" id="clientFirstName" class="form-control" placeholder="ex: Ion" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-navy">Nume de familie</label>
                        <input type="text" name="clientLastName" id="clientLastName" class="form-control" placeholder="ex: Popescu" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-navy">Număr Telefon</label>
                        <input type="text" name="clientPhone" id="clientPhone" class="form-control" placeholder="ex: 07xx xxx xxx" required />
                    </div>
                </div>

                <hr class="my-3 text-muted">

                <h6 class="text-navy fw-bold mb-3"><i class="bi bi-car-front me-2"></i>Detalii Auto & Serviciu</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-navy">Alege Serviciul</label>
                        <select name="serviceId" class="form-select" required>
                            <option value="">-- Alege serviciul --</option>
                            @foreach (var s in (IEnumerable<Service>)ViewBag.Services ?? new List<Service>())
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-navy">Alege Mecanicul</label>
                        <select name="mechanicId" class="form-select" required>
                            <option value="">-- Alege mecanicul --</option>
                            @foreach (var m in (IEnumerable<Mechanic>)ViewBag.Mechanics ?? new List<Mechanic>())
                            {
                                <option value="@m.Id">@m.FirstName @m.LastName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-navy">Data și Ora Programării</label>
                        <input type="text" name="appointmentDate" class="form-control flatpickr-datetime" placeholder="Selectează data și ora..." required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold text-navy">Marca Mașinii</label>
                        <input type="text" name="carMake" id="adminCarMakeInput" list="adminCarMakes" class="form-control" placeholder="ex: Dacia" required autocomplete="off" />
                        <datalist id="adminCarMakes">
                            <option value="Dacia"></option>
                            <option value="Volkswagen"></option>
                            <option value="BMW"></option>
                            <option value="Audi"></option>
                            <option value="Skoda"></option>
                            <option value="Mercedes-Benz"></option>
                            <option value="Renault"></option>
                            <option value="Ford"></option>
                            <option value="Toyota"></option>
                            <option value="Hyundai"></option>
                        </datalist>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold text-navy">Modelul Mașinii</label>
                        <input type="text" name="carModel" id="adminCarModelInput" list="adminCarModels" class="form-control" placeholder="ex: Logan" required autocomplete="off" />
                        <datalist id="adminCarModels"></datalist>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Notițe (Opțional)</label>
                    <textarea name="notes" class="form-control" rows="2" placeholder="Detalii suplimentare..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                <button type="submit" class="btn btn-primary-cta fw-bold">Creează Programarea</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            var $clientSelect = $('#clientSelectDropdown').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#adminCreateAppointmentModal'),
                width: '100%',
                placeholder: 'Client fără cont sau introducere manuală',
                allowClear: true,
                language: {
                    noResults: function () {
                        return "Nu am găsit niciun client.";
                    }
                }
            });

            $clientSelect.on('select2:select', function (e) {
                var selectedOption = e.params.data.element; 
                
                var firstName = selectedOption.dataset.firstname || '';
                var lastName = selectedOption.dataset.lastname || '';
                var phone = selectedOption.dataset.phone || '';

                $('#clientFirstName').val(firstName);
                $('#clientLastName').val(lastName);
                $('#clientPhone').val(phone);
            });

            $clientSelect.on('select2:unselect', function (e) {
                $('#clientFirstName').val('');
                $('#clientLastName').val('');
                $('#clientPhone').val('');
            });

            flatpickr("#adminDateFilter", {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                locale: "ro"
            });

            flatpickr(".flatpickr-datetime", {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                altInput: true,
                altFormat: "d/m/Y H:i",
                locale: "ro",
                time_24hr: true
            });

            const carData = {
                "Dacia": ["Logan", "Duster", "Sandero", "Spring", "Jogger", "Dokker", "Lodgy"],
                "Volkswagen": ["Golf", "Passat", "Polo", "Tiguan", "Touareg", "Touran", "Jetta", "Arteon", "Caddy"],
                "BMW": ["Seria 3", "Seria 5", "Seria 1", "X3", "X5", "X1", "Seria 4", "Seria 7", "X6"],
                "Audi": ["A4", "A6", "A3", "Q5", "Q7", "A5", "Q3", "A8"],
                "Skoda": ["Octavia", "Superb", "Fabia", "Kodiaq", "Rapid", "Scala", "Kamiq", "Karoq"],
                "Renault": ["Clio", "Megane", "Captur", "Kadjar", "Symbol", "Laguna", "Talisman", "Twingo", "Trafic"],
                "Ford": ["Focus", "Fiesta", "Mondeo", "Kuga", "Puma", "Transit", "Ecosport", "Mustang"],
                "Mercedes-Benz": ["Clasa C", "Clasa E", "Clasa A", "GLE", "GLC", "Clasa S", "Vito", "Sprinter"],
                "Toyota": ["Corolla", "Yaris", "RAV4", "C-HR", "Camry", "Auris", "Avensis", "Hilux"],
                "Hyundai": ["Tucson", "i30", "i20", "Kona", "Santa Fe", "Elantra", "Accent"]
            };

            const adminMakeInput = document.getElementById("adminCarMakeInput");
            const adminModelsDatalist = document.getElementById("adminCarModels");

            if (adminMakeInput) {
                adminMakeInput.addEventListener("input", function () {
                    const selectedMake = this.value.trim();
                    adminModelsDatalist.innerHTML = "";
                    
                    if (carData[selectedMake]) {
                        carData[selectedMake].forEach(function (model) {
                            const option = document.createElement("option");
                            option.value = model;
                            adminModelsDatalist.appendChild(option);
                        });
                    }
                });
            }
        });
    </script>
}