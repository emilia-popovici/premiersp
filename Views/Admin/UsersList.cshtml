@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model IEnumerable<PremierAuto.Controllers.ClientUserViewModel>

@{
    ViewData["Title"] = "Clienți Înregistrați";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-navy"><i class="bi bi-people-fill me-2"></i> Clienți Înregistrați</h2>
        <span class="badge bg-primary fs-6">Total: @Model.Count()</span>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm border-0 bg-white">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nume și Prenume</th>
                            <th>Email</th>
                            <th>Număr Telefon</th>
                            <th class="text-end">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            <tr>
                                <td class="fw-bold text-navy">@client.LastName @client.FirstName</td>
                                <td>@client.Email</td>
                                <td>@(string.IsNullOrEmpty(client.PhoneNumber) ? "Nespecificat" : client.PhoneNumber)</td>
                                <td class="text-end">
                                    <a asp-action="UserDetails" asp-route-userId="@client.UserId" class="btn btn-sm btn-outline-primary fw-bold">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Vezi Statistici
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>