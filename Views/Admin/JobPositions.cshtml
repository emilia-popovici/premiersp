@model IEnumerable<PremierAuto.Models.JobPosition>
@{
    ViewData["Title"] = "Gestionare Joburi";
    Layout = "_AdminLayout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-navy fw-bold mb-0">Posturi Disponibile</h2>
        <a asp-action="CreateJobPosition" class="btn btn-primary-cta fw-bold">
            <i class="bi bi-plus-lg me-2"></i> Adaugă Post Nou
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-navy">
                        <tr>
                            <th class="py-3 px-4">Titlu Post</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-center">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted">Niciun post adăugat.</td></tr>
                        }
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold">@job.Title</td>
                                <td>
                                    @if (job.IsHiring)
                                    {
                                        <span class="badge bg-success px-2 py-1">Angajăm</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Închis</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="EditJobPosition" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary fw-bold me-1">
                                        <i class="bi bi-pencil"></i> Editează
                                    </a>
                                    <form asp-action="DeleteJobPosition" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@job.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" onclick="return confirm('Sigur ștergi acest post?');">
                                            <i class="bi bi-trash"></i> Șterge
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>