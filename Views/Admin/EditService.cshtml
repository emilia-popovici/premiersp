@model PremierAuto.Models.Service
@{ 
    ViewData["Title"] = "Editează Serviciu"; 
    Layout = "_AdminLayout"; 
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 p-4">
            <h3 class="text-navy fw-bold mb-4">Editează serviciu</h3>
            <form asp-action="EditService" method="post">
                <input asp-for="Id" type="hidden" />
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Nume</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Descriere</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationMinutes" class="form-label fw-bold">Durată (minute)</label>
                        <input asp-for="DurationMinutes" class="form-control" min="1" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Preț (MDL)</label>
                        <input asp-for="Price" class="form-control" min="0" step="0.01" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary-cta fw-bold px-4">Salvează modificările</button>
                    <a asp-action="Services" class="btn btn-outline-secondary px-4">Anulează</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
}