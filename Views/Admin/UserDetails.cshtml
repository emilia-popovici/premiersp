@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model PremierAuto.Models.ApplicationUser
@{
    ViewData["Title"] = "Statistici Utilizator";
    var profile = ViewBag.ClientProfile as PremierAuto.Models.ClientProfile;
    var appointments = ViewBag.Appointments as List<PremierAuto.Models.Appointment>;
    var profilePicUrl = !string.IsNullOrEmpty(profile?.ProfilePictureUrl) ? profile.ProfilePictureUrl : "/images/default-avatar.svg";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="UsersList" class="btn btn-outline-secondary btn-sm fw-bold mb-3">
            <i class="bi bi-arrow-left me-1"></i> Înapoi la listă
        </a>
        <h2 class="fw-bold text-navy">Profil și Statistici: <br /> @Model.FirstName @Model.LastName</h2>
    </div>

    <div class="position-relative mb-4">
        <img src="@profilePicUrl" alt="Profil Client" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid var(--navy);" />
    </div>

    <div class="row g-4 mb-4">
        <!-- informatii personale -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 bg-white h-100">
                <h5 class="fw-bold text-navy mb-3"><i class="bi bi-person-badge me-2"></i> Date Personale</h5>
                <p class="mb-2"><strong>Nume:</strong> @(profile != null ? $"{profile.FirstName} {profile.LastName}" : "Nespecificat")</p>
                <p class="mb-2"><strong>Telefon:</strong> @(profile?.PhoneNumber ?? "Fără număr")</p>
                <p class="mb-0"><strong>Email:</strong> <span class="text-primary fw-bold">@ViewBag.UserEmail</span></p>
            </div>
        </div>

        <!-- statistici principale -->
        <div class="col-md-8">
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="card border-0 shadow-sm p-3 bg-light border-start border-4 border-success h-100">
                        <small class="text-muted fw-bold">TOTAL ACHITAT</small>
                        <h3 class="fw-bold text-success mb-0">@ViewBag.TotalPaid RON</h3>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card border-0 shadow-sm p-3 bg-light border-start border-4 border-primary h-100">
                        <small class="text-muted fw-bold">PROGRAMĂRI FINALIZATE</small>
                        <h3 class="fw-bold text-navy mb-0">@ViewBag.CompletedCount</h3>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card border-0 shadow-sm p-3 bg-light border-start border-4 border-warning h-100">
                        <small class="text-muted fw-bold">RATING MEDIU OFERIT</small>
                        <h3 class="fw-bold text-dark mb-0">@(((double)ViewBag.AverageRating).ToString("0.0")) <i class="bi bi-star-fill text-warning fs-5"></i></h3>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card border-0 shadow-sm p-3 bg-light border-start border-4 border-info h-100">
                        <small class="text-muted fw-bold">ULTIMA VIZITĂ</small>
                        <h6 class="fw-bold text-dark mb-0 mt-2">
                            @(ViewBag.LastCompletedDate != null ? ((DateTime)ViewBag.LastCompletedDate).ToString("dd.MM.yyyy HH:mm") : "Niciuna")
                        </h6>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- masinile clientului -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 border-start border-4 border-info">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-bold text-info mb-0"><i class="bi bi-car-front me-2"></i> Garajul Clientului (Pașaport Tehnic)</h5>
                    <button class="btn btn-sm btn-info text-white fw-bold" data-bs-toggle="modal" data-bs-target="#carModal" onclick="resetCarForm()">
                        <i class="bi bi-plus-lg me-1"></i> Adaugă Mașină
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-navy">
                                <tr>
                                    <th class="py-3 px-4">Marcă & Model</th>
                                    <th class="py-3">Nr. Înmatriculare</th>
                                    <th class="py-3">Serie Șasiu (VIN)</th>
                                    <th class="py-3 text-center">An</th>
                                    <th class="py-3 text-center px-4">Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.ClientCars == null || !((IEnumerable<PremierAuto.Models.ClientCar>)ViewBag.ClientCars).Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-4">Acest client nu are nicio mașină înregistrată.</td></tr>
                                }
                                else
                                {
                                    foreach (var car in ViewBag.ClientCars)
                                    {
                                        <tr>
                                            <td class="px-4 fw-bold">@car.CarMake @car.CarModel</td>
                                            <td><span class="badge bg-light text-dark border border-secondary fs-6">@car.LicensePlate</span></td>
                                            <td class="text-muted font-monospace">@car.VIN</td>
                                            <td class="text-center">@car.Year</td>
                                            <td class="text-center px-4">
                                                <button class="btn btn-sm btn-outline-primary" onclick="editCar(@car.Id, '@car.CarMake', '@car.CarModel', '@car.LicensePlate', '@car.VIN', '@car.Year')">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- info extra mecanic + serviciu preferat -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 bg-white h-100">
                <h6 class="text-muted fw-bold">Mecanicul preferat (frecventat cel mai des)</h6>
                <h4 class="fw-bold text-navy mb-0"><i class="bi bi-wrench me-2"></i> @ViewBag.FavoriteMechanic</h4>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 bg-white h-100">
                <h6 class="text-muted fw-bold">Serviciul cel mai folosit</h6>
                <h4 class="fw-bold text-navy mb-0"><i class="bi bi-gear-wide-connected me-2"></i> @ViewBag.MostUsedService</h4>
            </div>
        </div>
    </div>
</div>

<!--  pasaport tehnic / add masina -->
<div class="modal fade" id="carModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-navy"><i class="bi bi-card-heading me-2"></i>Date Pașaport Tehnic</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                
                <!-- scanare ocr -->
                <div class="alert alert-info border-0 shadow-sm mb-4">
                    <h6 class="fw-bold"><i class="bi bi-camera me-2"></i>Scanare Automată (Față + Verso)</h6>
                    <p class="small mb-3">Încarcă pozele pașaportului tehnic pentru a extrage automat datele.</p>
                    
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted mb-1">Poză Față</label>
                            <input type="file" id="passportFront" class="form-control form-control-sm" accept="image/*" capture="environment">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted mb-1">Poză Verso</label>
                            <input type="file" id="passportBack" class="form-control form-control-sm" accept="image/*" capture="environment">
                        </div>
                    </div>

                    <button type="button" id="scanBtn" class="btn btn-info btn-sm text-white fw-bold w-100" onclick="scanDocument()">
                        <i class="bi bi-search me-1"></i> Scanează Documentele
                    </button>
                    <div id="scanStatus" class="text-center mt-2 small fw-bold text-primary" style="display:none;">
                        <span class="spinner-border spinner-border-sm me-1"></span> Se procesează imaginile... te rog așteaptă.
                    </div>
                </div>

                <!-- formular de date -->
                <form asp-controller="Admin" asp-action="SaveClientCar" method="post" id="carForm">
                    <input type="hidden" name="clientId" value="@Model.Id" />
                    <input type="hidden" name="carId" id="carId" value="0" />

                    <div class="row g-2">
                        <!-- vehicul si model -->
                        <h6 class="fw-bold text-navy w-100 mt-3 border-bottom pb-1">Vehicul</h6>
                        <div class="col-md-3"><label class="small text-muted mb-0">A: Nr. Înmatriculare</label><input type="text" name="licensePlate" id="fA" class="form-control form-control-sm" /></div>
                        <div class="col-md-3"><label class="small text-muted mb-0">B: Anul</label><input type="number" name="year" id="fB" class="form-control form-control-sm" /></div>
                        <div class="col-md-3"><label class="small text-muted mb-0">D1: Marca *</label><input type="text" name="make" id="fD1" class="form-control form-control-sm fw-bold" required /></div>
                        <div class="col-md-3"><label class="small text-muted mb-0">D3: Model *</label><input type="text" name="model" id="fD3" class="form-control form-control-sm fw-bold" required /></div>
                        <div class="col-md-12"><label class="small text-muted mb-0">D2: Tipul vehiculului</label><input type="text" name="vehicleType" id="fD2" class="form-control form-control-sm" /></div>
                        <!-- id -->
                        <h6 class="fw-bold text-navy w-100 mt-3 border-bottom pb-1">Identificare șasiu / RST</h6>
                        <div class="col-md-6"><label class="small text-muted mb-0">E: VIN (Serie Șasiu)</label><input type="text" name="vin" id="fE" class="form-control form-control-sm font-monospace fw-bold" maxlength="17" /></div>
                        <div class="col-md-6"><label class="small text-muted mb-0">IDNV (Cod RST)</label><input type="text" name="idnv" id="fIDNV" class="form-control form-control-sm" /></div>
                        <div class="col-md-6"><label class="small text-muted mb-0">E1: Nr. Caroserie</label><input type="text" name="bodyNumber" id="fE1" class="form-control form-control-sm" /></div>
                        <div class="col-md-6"><label class="small text-muted mb-0">E2: Nr. Șasiu</label><input type="text" name="chassisNumber" id="fE2" class="form-control form-control-sm" /></div>

                        <!-- date tehnice -->
                        <h6 class="fw-bold text-navy w-100 mt-3 border-bottom pb-1">Date Tehnice & Mase</h6>
                        <div class="col-md-4"><label class="small text-muted mb-0">J1: Categorie</label><input type="text" name="category" id="fJ1" class="form-control form-control-sm" /></div>
                        <div class="col-md-4"><label class="small text-muted mb-0">J2: Tip Caroserie</label><input type="text" name="bodyStyle" id="fJ2" class="form-control form-control-sm" /></div>
                        <div class="col-md-4"><label class="small text-muted mb-0">R: Culoare</label><input type="text" name="color" id="fR" class="form-control form-control-sm" /></div>
                        
                        <div class="col-md-3"><label class="small text-muted mb-0">P1: Cap. (cm3)</label><input type="number" name="engineCapacity" id="fP1" class="form-control form-control-sm" /></div>
                        <div class="col-md-3"><label class="small text-muted mb-0">P3: Combustibil</label><input type="text" name="fuelType" id="fP3" class="form-control form-control-sm" /></div>
                        <div class="col-md-3"><label class="small text-muted mb-0">Q: kW/kg</label><input type="text" name="powerWeightRatio" id="fQ" class="form-control form-control-sm" /></div>
                        <div class="col-md-3"><label class="small text-muted mb-0">S1: Locuri</label><input type="number" name="seats" id="fS1" class="form-control form-control-sm" /></div>
                        
                        <div class="col-md-6"><label class="small text-muted mb-0">F1: Masă Max (kg)</label><input type="number" name="maxMass" id="fF1" class="form-control form-control-sm" /></div>
                        <div class="col-md-6"><label class="small text-muted mb-0">G: Masă Proprie (kg)</label><input type="number" name="ownMass" id="fG" class="form-control form-control-sm" /></div>
                    </div>
                    
                    <hr class="my-4 text-muted">
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                        <button type="submit" class="btn btn-primary-cta fw-bold"><i class="bi bi-save me-1"></i> Salvează</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>
    <script>
        function resetCarForm() {
            document.getElementById('carId').value = "0";
            document.getElementById('carForm').reset();
            document.getElementById('scanStatus').style.display = 'none';
        }
        
        function editCar(id, make, model, plate, vin, year) {
            document.getElementById('carId').value = id;
            document.getElementById('fD1').value = make;
            document.getElementById('fD3').value = model;
            document.getElementById('fA').value = plate;
            document.getElementById('fE').value = vin;
            document.getElementById('fB').value = year;
            var modal = new bootstrap.Modal(document.getElementById('carModal'));
            modal.show();
        }

        async function scanDocument() {
            const frontInput = document.getElementById('passportFront');
            const backInput = document.getElementById('passportBack');
            const statusDiv = document.getElementById('scanStatus');
                
            if (frontInput.files.length === 0 && backInput.files.length === 0) {
                alert("Te rog să încarci cel puțin o poză!"); return;
            }

            statusDiv.style.display = 'block';
            statusDiv.className = 'text-center mt-2 small fw-bold text-primary';
            statusDiv.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Analizez toate câmpurile...';
                
            try {
                let scanTasks = [];
                if (frontInput.files.length > 0) scanTasks.push(Tesseract.recognize(frontInput.files[0], 'eng+ron+rus'));
                if (backInput.files.length > 0) scanTasks.push(Tesseract.recognize(backInput.files[0], 'eng+ron+rus'));

                const results = await Promise.all(scanTasks);
                const fullText = results.map(r => r.data.text.toUpperCase()).join(" \n ");
                
                console.log("Text brut extras:\n", fullText); 

                let d = {}; 

                const vinMatch = fullText.match(/\b[A-HJ-NPR-Z0-9]{17}\b/);
                if (vinMatch) d.fE = vinMatch[0];

                const plateMatch = fullText.match(/\b([A-Z]{1,3}\s*\d{2,3}\s*[A-Z]{0,3})\b/);
                if (plateMatch) d.fA = plateMatch[0].replace(/\s+/g, '');

                const yearMatch = fullText.match(/\b(19[9][0-9]|20[0-2][0-9])\b/);
                if (yearMatch) d.fB = yearMatch[0];

                const popularMakes = ["DACIA", "VOLKSWAGEN", "VW", "BMW", "AUDI", "SKODA", "MERCEDES", "RENAULT", "FORD", "TOYOTA"];
                for (let make of popularMakes) {
                    if (fullText.includes(make)) {
                        d.fD1 = make === "VW" ? "VOLKSWAGEN" : make;
                        break;
                    }
                }

                const d3d2Match = fullText.match(/D\.?[32][\s\:\.]+([A-Z0-9][A-Z0-9\-\s]{2,15})\b/i);
                if (d3d2Match) {
                    d.fD3 = d3d2Match[1].trim();
                } else if (d.fD1) {
                    const fallbackRegex = new RegExp(d.fD1 + "[\\s\\n]+(?:D\\.?2[\\s\\n]+)?([A-Z0-9]{3,})", "i");
                    const fallbackMatch = fullText.match(fallbackRegex);
                    if (fallbackMatch) d.fD3 = fallbackMatch[1].trim();
                }

                const lines = fullText.split('\n');
                for (let line of lines) {
                    line = line.trim().replace(/,/g, '.');
                    if (!line) continue;

                    if (line.match(/\bA[\s\:\.]+(.+)/) && !d.fA) d.fA = RegExp.$1.replace(/[\s\-]/g, '');
                    if (line.match(/\bB[\s\:\.]+(\d{4})/)) d.fB = RegExp.$1;
                    
                    if (line.match(/\bC\.?1\.?1[\s\:\.]+(.+)/)) d.fC1_1 = RegExp.$1.trim();
                    if (line.match(/\bC\.?1\.?2[\s\:\.]+(.+)/)) d.fC1_2 = RegExp.$1.trim();
                    if (line.match(/\bC\.?1\.?3[\s\:\.]+(.+)/)) d.fC1_3 = RegExp.$1.trim();
                    if (line.match(/\bC\.?4[\s\:\.]+(.+)/)) d.fC4 = RegExp.$1.trim();
                    
                    if (line.match(/\bD\.?1[\s\:\.]+(.+)/) && !d.fD1) d.fD1 = RegExp.$1.trim();
                    if (line.match(/\bD\.?2[\s\:\.]+(.+)/)) d.fD2 = RegExp.$1.trim();
                    if (line.match(/\bD\.?3[\s\:\.]+(.+)/) && !d.fD3) d.fD3 = RegExp.$1.trim();
                    
                    if (line.match(/\bE[\s\:\.]+(.+)/) && !d.fE) d.fE = RegExp.$1.trim();
                    if (line.match(/\bE\.?1[\s\:\.]+(.+)/)) d.fE1 = RegExp.$1.trim();
                    if (line.match(/\bE\.?2[\s\:\.]+(.+)/)) d.fE2 = RegExp.$1.trim();
                    
                    if (line.match(/\bF\.?1[\s\:\.]+(\d+)/)) d.fF1 = RegExp.$1;
                    if (line.match(/\bG[\s\:\.]+(\d+)/)) d.fG = RegExp.$1;
                    if (line.match(/\bH[\s\:\.]+(.+)/)) d.fH = RegExp.$1.trim();
                    if (line.match(/\bI[\s\:\.]+(.+)/)) d.fI = RegExp.$1.trim();
                    
                    if (line.match(/\bJ\.?1[\s\:\.]+(.+)/)) d.fJ1 = RegExp.$1.trim();
                    if (line.match(/\bJ\.?2[\s\:\.]+(.+)/)) d.fJ2 = RegExp.$1.trim();
                    if (line.match(/\bP\.?1[\s\:\.]+(\d+)/)) d.fP1 = RegExp.$1;
                    if (line.match(/\bP\.?3[\s\:\.]+(.+)/)) d.fP3 = RegExp.$1.trim();
                    if (line.match(/\bQ[\s\:\.]+(.+)/)) d.fQ = RegExp.$1.trim();
                    if (line.match(/\bR[\s\:\.]+(.+)/)) d.fR = RegExp.$1.trim();
                    if (line.match(/\bS\.?1[\s\:\.]+(\d+)/)) d.fS1 = RegExp.$1;
                    
                    if (line.match(/\bX\.?1[\s\:\.]+(.+)/)) d.fX1 = RegExp.$1.trim();
                    if (line.match(/\bZ[\s\:\.]+(.+)/)) d.fZ = RegExp.$1.trim();
                    if (line.match(/\bIDNV(?:[\s\:\.]+RST)?[\s\:\.]+(\d+)/)) d.fIDNV = RegExp.$1;
                }

                for (let key in d) {
                    if (document.getElementById(key) && d[key] !== "") {
                        document.getElementById(key).value = d[key];
                    }
                }

                statusDiv.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> Scanare completă! Verifică datele introduse.';
                statusDiv.classList.replace('text-primary', 'text-success');
                
            } catch (err) {
                console.error(err);
                statusDiv.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger"></i> Eroare OCR. Introdu manual datele.';
                statusDiv.classList.replace('text-primary', 'text-danger');
            }
        }
    </script>
}