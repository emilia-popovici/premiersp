@model IEnumerable<PremierAuto.Models.Service>
@{
    ViewData["Title"] = "Gestionare Servicii";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="text-navy fw-bold mb-0">Lista Serviciilor</h2>
    <a asp-action="CreateService" class="btn btn-primary-cta fw-bold">+ Adaugă Serviciu Nou</a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group shadow-sm" style="max-width: 400px;">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Caută după nume sau descriere..." />
        <button class="btn btn-dark" type="submit">
            <i class="bi bi-search"></i> Caută
        </button>
        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
        {
            <a asp-action="Index" class="btn btn-outline-secondary" title="Resetează">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover bg-white mb-0 align-middle" style="min-width: 800px;">
            <thead class="bg-navy text-white">
                <tr>
                    <th class="ps-3 text-nowrap">Nume</th>
                    <th style="width: 40%;">Descriere</th>
                    <th class="text-nowrap">Durată</th>
                    <th class="pe-3 text-end text-nowrap">Acțiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold text-nowrap">@s.Name</td>
                        <td class="small text-muted text-wrap">@s.Description</td>
                        <td class="text-nowrap">@s.DurationMinutes min</td>
                        <td class="pe-3 text-end">
                            <div class="d-flex justify-content-end gap-2 flex-nowrap">
                                <a asp-action="EditService" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary fw-bold">Editează</a>
                                <form asp-action="DeleteService" method="post" onsubmit="return confirm('Sigur vrei să ștergi acest serviciu?');">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger fw-bold">Șterge</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>