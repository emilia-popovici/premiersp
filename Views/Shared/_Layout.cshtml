<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PremierAuto</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PremierAuto.styles.css" asp-append-version="true" />

    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png">
    <link rel="shortcut icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    <link rel="manifest" href="~/site.webmanifest">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container px-4">
                <a class="navbar-brand logo-text" asp-controller="Home" asp-action="Index">
                    <span class="logo-badge"><i class="bi-car-front-fill"></i></span>
                    <span class="logo-word">PREMIER <span class="text-accent">SP</span> AUTO</span>
                </a>
                
                <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Acasă</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Services">Servicii</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Administrare</a>
                            </li>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">Profil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="Index">Programările mele</a>
                            </li>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            @await Component.InvokeAsync("Notifications")
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <div class="page-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-4 pb-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="logo-badge"><i class="bi bi-speedometer2"></i></span>
                        <span class="footer-brand">PREMIER <span class="text-accent">SP</span> AUTO</span>
                    </div>
                    <p class="mb-0" style="max-width:320px;">Service auto modern, construit pe experiență. Diagnoză precisă și mecanici specializați, într-un singur loc.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Navigare</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Acasă</a></li>
                        <li><a asp-controller="Appointment" asp-action="Create">Programează-te</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Cont</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Profile" asp-action="Index">Profilul meu</a></li>
                        <li><a asp-controller="Appointment" asp-action="Index">Programările mele</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6>Contact</h6>
                    <ul class="footer-links">
                        <li>
                            <a href="https://maps.app.goo.gl/sQQ67W78FHmhCgsMA" target="_blank" class="text-white text-decoration-none d-inline-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-geo-alt text-accent"></i><span>Str. Calea Ieșilor 111, Chișinău, Moldova</span>
                            </a>
                        </li>
                        <li>
                            <a href="tel:+37369333694" class="text-white text-decoration-none d-inline-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-telephone text-accent"></i><span>+373 693 33 694</span>
                            </a>
                        </li>
                        <li>
                            <div class="text-white text-decoration-none d-inline-flex align-items-center gap-2">
                                <i class="bi bi-clock text-accent"></i><span>Luni–Vineri, 09:00–17:00</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom pt-3 d-flex flex-column flex-sm-row justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year Premier SP Auto. Toate drepturile rezervate.</span>
                <span>Chișinău &middot; Republica Moldova</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>