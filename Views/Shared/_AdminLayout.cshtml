<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin PremierAuto</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png">
    <link rel="shortcut icon" href="~/favicon.ico">

    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    <link rel="manifest" href="~/site.webmanifest">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
</head>
<body>
    <div class="d-md-none bg-navy text-white p-3 d-flex justify-content-between align-items-center shadow-sm sticky-top">
        <span class="fs-5 fw-bold">PREMIER SP AUTO</span>
        <button class="btn btn-outline-light border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
            <i class="bi bi-list fs-2"></i>
        </button>
    </div>

    <div class="d-flex flex-nowrap align-items-start">
        <div id="adminSidebar" class="bg-navy text-white d-flex flex-column shadow offcanvas-md offcanvas-start sticky-md-top vh-100" tabindex="-1" style="width: 280px; z-index: 1050;">
            <div class="offcanvas-header d-md-none border-bottom border-light pt-3 pb-3">
                <h5 class="offcanvas-title fw-bold text-white">Meniu Admin</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar"></button>
            </div>

            <div class="offcanvas-body d-flex flex-column p-3 h-100 w-100">
                <a href="/" class="d-none d-md-flex align-items-center mb-4 text-white text-decoration-none">
                    <span class="fs-4 fw-bold">PREMIER SP AUTO</span>
                </a>
                <hr class="text-white-50 d-none d-md-block mt-0">
                
                <ul class="nav nav-pills flex-column mb-auto mt-2 w-100" style="overflow-y: auto;">
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="Index" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active bg-danger" : "")">
                            <i class="bi bi-bar-chart-fill me-2"></i> Statistici & Dashboard
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="UsersList" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "UsersList" ? "active bg-danger" : "")">
                            <i class="bi bi-people-fill me-2"></i> Clienți
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="Mechanics" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Mechanics" ? "active bg-danger" : "")">
                            <i class="bi bi-tools me-2"></i> Mecanici
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="Services" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Services" ? "active bg-danger" : "")">
                            <i class="bi bi-wrench-adjustable-circle-fill me-2"></i> Servicii
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="Appointments" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Appointments" ? "active bg-danger" : "")">
                            <i class="bi bi-calendar-check-fill me-2"></i> Programări
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["Action"].ToString() == "Payments" ? "active bg-primary-cta rounded" : "")" asp-controller="Admin" asp-action="Payments">
                            <i class="bi bi-wallet2 me-2"></i> Plăți & Facturare
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="AllChats" class="nav-link text-white @(ViewContext.RouteData.Values["Action"]?.ToString() == "AllChats" ? "active bg-danger" : "")">
                            <i class="bi bi-chat-dots-fill me-2"></i> Chat-uri Active
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["Action"]?.ToString() == "ChatHistory" ? "active bg-white bg-opacity-10 rounded" : "")" asp-controller="Admin" asp-action="ChatHistory">
                            <i class="bi bi-clock-history me-2"></i> Istoric Chat-uri
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="JobPositions" class="nav-link text-white @(ViewContext.RouteData.Values["Action"]?.ToString() == "JobPositions" ? "active bg-danger" : "")">
                            <i class="bi bi-card-list me-2"></i> Gestionare Joburi
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Admin" asp-action="JobApplications" class="nav-link text-white @(ViewContext.RouteData.Values["Action"]?.ToString() == "JobApplications" ? "active bg-danger" : "")">
                            <i class="bi bi-briefcase-fill me-2"></i> CV-uri & Angajări
                        </a>
                    </li>
                </ul>
                
                <div class="mt-3 pt-3 border-top border-secondary">
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-outline-light w-100 fw-bold">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="flex-grow-1 bg-light d-flex flex-column" style="min-width: 0; min-height: 100vh;">
            <nav class="navbar navbar-light bg-white border-bottom shadow-sm px-4 py-3 d-none d-md-block sticky-top">
                <div class="container-fluid">
                    <span class="navbar-brand mb-0 h4 fw-bold text-navy">Panou de Administrare</span>
                </div>
            </nav>

            <main class="p-3 p-md-4 flex-grow-1">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show fw-bold shadow-sm" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                @RenderBody()
            </main>
            
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>