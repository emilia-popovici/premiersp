@using PremierAuto.Models
@model PremierAuto.ViewModels.ClientProfileViewModel

@{
    ViewData["Title"] = "Profilul Meu";
    var clientCars = ViewBag.ClientCars as IEnumerable<ClientCar> ?? new List<ClientCar>();
    int carsCount = clientCars.Count();
}

<div class="container mt-5 mb-5">

    <div class="row g-4 justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-5 bg-light">
                    <h2 class="text-center text-navy fw-bold mb-4">Datele Tale</h2>
                    <p class="text-center text-muted mb-4">Completează aceste detalii pentru a putea fi contactat în legătură cu programările tale.</p>
                    
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="Poză profil" class="rounded-circle shadow-sm border border-3 border-white" style="width: 120px; height: 120px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center shadow-sm border border-3 border-light" style="width: 120px; height: 120px;">
                                <i class="bi bi-person text-secondary" style="font-size: 4rem;"></i>
                            </div>
                        }
                    </div>

                    <form asp-controller="Profile" asp-action="Index" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-bold text-navy">Prenume</label>
                            <input asp-for="FirstName" class="form-control" placeholder="ex: Emilia" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-bold text-navy">Nume de familie</label>
                            <input asp-for="LastName" class="form-control" placeholder="ex: Popovici" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label fw-bold text-navy">Număr de Telefon</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="ex: 07xx xxx xxx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-navy">Poză de profil (Opțional)</label>
                            <input type="file" name="profilePicture" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="btn btn-primary-cta btn-lg fw-bold">
                                <i class="bi bi-save me-2"></i> Salvează Profilul
                            </button>
                            
                            <a asp-controller="Profile" asp-action="ChangeEmail" class="btn btn-outline-secondary btn-lg fw-bold">
                                <i class="bi bi-envelope-at me-2"></i> Schimbă Email
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 bg-light text-center">
                    <h5 class="fw-bold text-navy mb-3"><i class="bi bi-shield-lock me-2"></i>Securitate Cont</h5>
                    @if (ViewBag.HasPassword)
                    {
                        <a href="/Identity/Account/Manage/ChangePassword" class="btn btn-outline-secondary w-100 fw-bold">
                            <i class="bi bi-key"></i> Schimbă Parola
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning small border-0 text-start">
                            <i class="bi bi-info-circle me-1"></i> Te-ai autentificat cu Google, deci nu ai o parolă setată.
                        </div>
                        <a href="/Identity/Account/Manage/SetPassword" class="btn btn-warning w-100 fw-bold text-dark">
                            <i class="bi bi-key-fill"></i> Setează o Parolă
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 bg-light d-flex flex-column">
                    <h4 class="text-navy fw-bold mb-2"><i class="bi bi-car-front-fill me-2 text-accent"></i>Garajul Meu</h4>
                    <p class="text-muted small mb-4">Gestionează mașinile tale pentru o programare mai rapidă în service.</p>

                    <div class="flex-grow-1">
                        @if (clientCars.Any())
                        {
                            <div class="list-group mb-4">
                                @foreach (var car in clientCars)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center bg-white border-0 shadow-sm mb-2 rounded-3">
                                        <div>
                                            <h6 class="mb-1 fw-bold text-navy">@car.CarMake @car.CarModel</h6>
                                            @if (!string.IsNullOrEmpty(car.LicensePlate))
                                            {
                                                <span class="badge bg-secondary text-uppercase py-1">@car.LicensePlate</span>
                                            }
                                        </div>
                                        <form asp-action="DeleteCar" method="post" class="m-0" onsubmit="return confirm('Ești sigur că vrei să ștergi această mașină?');">
                                            <input type="hidden" name="id" value="@car.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Șterge mașina">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-car-front text-muted opacity-25" style="font-size: 4rem;"></i>
                                <p class="text-muted mt-3">Nu ai adăugat nicio mașină în garaj.</p>
                            </div>
                        }
                    </div>

                    <div class="mt-auto border-top pt-4">
                        @if (carsCount < 5)
                        {
                            <button type="button" class="btn btn-outline-primary w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#addCarModal">
                                <i class="bi bi-plus-lg me-1"></i> Adaugă Mașină (@carsCount/5)
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-secondary text-center small mb-0 border-0">
                                <i class="bi bi-info-circle me-1"></i> Ai atins limita maximă de 5 mașini.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addCarModal" tabindex="-1" aria-labelledby="addCarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="AddCar" method="post" class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-navy" id="addCarModalLabel"><i class="bi bi-car-front me-2"></i>Adaugă o mașină nouă</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Marca *</label>
                    <input type="text" name="carMake" id="profileCarMakeInput" list="profileCarMakes" class="form-control" placeholder="ex: Renault" required autocomplete="off" />
                    <datalist id="profileCarMakes">
                        <option value="Dacia"></option>
                        <option value="Volkswagen"></option>
                        <option value="BMW"></option>
                        <option value="Audi"></option>
                        <option value="Skoda"></option>
                        <option value="Mercedes-Benz"></option>
                        <option value="Renault"></option>
                        <option value="Ford"></option>
                        <option value="Toyota"></option>
                        <option value="Hyundai"></option>
                    </datalist>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Model *</label>
                    <input type="text" name="carModel" id="profileCarModelInput" list="profileCarModels" class="form-control" placeholder="ex: Logan" required autocomplete="off" />
                    <datalist id="profileCarModels"></datalist>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Număr înmatriculare *</label>
                    <input type="text" name="licensePlate" class="form-control text-uppercase" placeholder="ex: B 123 ABC" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">VIN *</label>
                    <input type="text" name="vin" class="form-control text-uppercase" placeholder="ex: 1FA6P8CF0H5123456" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">An </label>
                    <input type="text" name="year" class="form-control text-uppercase" placeholder="ex: 2012" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Tip combustibil sau Sursă de putere </label>
                    <input type="text" name="fuelType" class="form-control text-uppercase" placeholder="ex: 1FA6P8CF0H5123456" />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                <button type="submit" class="btn btn-primary-cta fw-bold">Salvează Mașina</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carData = {
                "Dacia": ["Logan", "Duster", "Sandero", "Spring", "Jogger", "Dokker", "Lodgy"],
                "Volkswagen": ["Golf", "Passat", "Polo", "Tiguan", "Touareg", "Touran", "Jetta", "Arteon", "Caddy"],
                "BMW": ["Seria 3", "Seria 5", "Seria 1", "X3", "X5", "X1", "Seria 4", "Seria 7", "X6"],
                "Audi": ["A4", "A6", "A3", "Q5", "Q7", "A5", "Q3", "A8"],
                "Skoda": ["Octavia", "Superb", "Fabia", "Kodiaq", "Rapid", "Scala", "Kamiq", "Karoq"],
                "Renault": ["Clio", "Megane", "Captur", "Kadjar", "Symbol", "Laguna", "Talisman", "Twingo", "Trafic"],
                "Ford": ["Focus", "Fiesta", "Mondeo", "Kuga", "Puma", "Transit", "Ecosport", "Mustang"],
                "Mercedes-Benz": ["Clasa C", "Clasa E", "Clasa A", "GLE", "GLC", "Clasa S", "Vito", "Sprinter"],
                "Toyota": ["Corolla", "Yaris", "RAV4", "C-HR", "Camry", "Auris", "Avensis", "Hilux"],
                "Hyundai": ["Tucson", "i30", "i20", "Kona", "Santa Fe", "Elantra", "Accent"]
            };

            const makeInput = document.getElementById("profileCarMakeInput");
            const modelsDatalist = document.getElementById("profileCarModels");

            makeInput.addEventListener("input", function () {
                const selectedMake = this.value.trim();
                modelsDatalist.innerHTML = "";
                
                if (carData[selectedMake]) {
                    carData[selectedMake].forEach(function (model) {
                        const option = document.createElement("option");
                        option.value = model;
                        modelsDatalist.appendChild(option);
                    });
                }
            });
        });
    </script>
}