@model PremierAuto.ViewModels.ChangeEmailViewModel

@{
    ViewData["Title"] = "Schimbare Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0 p-4 bg-white">
                <div class="mb-4 text-center">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-envelope-at text-navy fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-navy">Modifică Adresa de Email</h3>
                    <p class="text-muted">Pentru siguranța contului tău, te rugăm să introduci parola curentă.</p>
                </div>

                <form asp-action="ChangeEmail" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-bold">Parola Curentă</label>
                        <input asp-for="CurrentPassword" class="form-control form-control-lg" placeholder="••••••••" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewEmail" class="form-label fw-bold">Noul Email</label>
                        <input asp-for="NewEmail" class="form-control form-control-lg" placeholder="nume@exemplu.com" />
                        <span asp-validation-for="NewEmail" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold">
                            <i class="bi bi-save me-2"></i> Actualizează Emailul
                        </button>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary fw-bold">
                            Anulează
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}